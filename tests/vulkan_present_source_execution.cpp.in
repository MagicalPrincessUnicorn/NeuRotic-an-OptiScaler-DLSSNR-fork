// PRODUCTION_INITIALIZATION_ELIGIBILITY
// PRODUCTION_INITIALIZATION_RESULTS
struct VkPresentInitializationRequest {};
static int initializationCalls=0,initializationMutation=0;
static VkPresentInitializationStatus initializationStatus=VkPresentInitializationStatus::Ready;
static void PollPresentInitializationVk(){}
static VkPresentInitializationStep PreparePresentModelsVk(const VkPresentInitializationRequest&,VkCommandBuffer,VkNrUseId){
 VkPresentInitializationStep step;step.status=initializationStatus;step.modelLifetime=liveModel;return step;
}
static int mutateDuringRecord=0,mutateDuringProvider=0;
static void ApplyInitializationMutation(int mutation){
  switch(mutation){
   case 1:++Config::Instance()->revision;break;
   case 2:++policy.revision;break;
   case 3:++liveModel->resumeGeneration;break;
   case 4:GetVulkanPresentRegistry().proof=std::make_shared<VkNrAcquireProof>();break;
   case 5:++guideIdentity;break;
   case 6:++FinalFallback::inputInterruptionEpoch;break;
   case 7:queueValid=false;break;
   case 8:Config::Instance()->enabled=false;break;
   case 9:fixtureNow+=std::chrono::milliseconds(101);break;
  }
}
class VkPresentInitializationOwner {
 VkDevice device_{};
public:
 VkDevice Device()const{return device_;}
 bool Busy()const{return false;}
 void Maintain(void(*)()){}
 bool Release(bool,void(*)()){device_={};return true;}
 template<class Current,class PrepareCallback,class Poll>
 VkPresentInitializationResult Prepare(const VkPresentInitializationRequest& request,Current current,PrepareCallback prepare,Poll){
  ++initializationCalls;device_=Handle<VkDevice>(1);
  if(!current())return {VkPresentInitializationStatus::Refused,"initial proof rejected"};
  const auto step=prepare(request,{},VkNrUseId{1});
  ApplyInitializationMutation(initializationMutation);
  // The real transport owns stage/completion tests separately. This seam tests
  // the actual executor's post-initialization freshness and once-only effects.
  return {step.status,step.status==VkPresentInitializationStatus::Ready?"":"fixture initializer not ready",1};
 }
};
struct VkPresentConsumer {bool Complete()const{return consumerComplete;}};
struct FakeConsumers {std::shared_ptr<VkPresentConsumer> Register(VkDevice,uint64_t,VkSemaphore){return std::make_shared<VkPresentConsumer>();}};
static FakeConsumers& VulkanPresentConsumers(){static FakeConsumers r;return r;}
static uint64_t VkNrCompletionDeviceGeneration(VkDevice){return 1;}
static VkResult WaitVkNrUse(VkNrUseId,uint64_t){return consumerComplete?VK_SUCCESS:VK_TIMEOUT;}
struct FakeStatus {
 std::optional<VkPresentSources::Context> context;uint64_t revision=0,last=0;
 void ObserveSourcePolicy(const Connections::Mixed::Policy& p,const VkPresentSources::Context& c,uint64_t){context=c;revision=p.revision;}
 void GpuCompleted(){}
 bool SourceCompleted(const VkPresentSources::Receipt& r,uint64_t current){
  if(!context||r.context!=*context||!r.completeTarget||!VkPresentSources::CurrentModelMatches(r.context,liveModel)||r.signals.revision!=current||revision!=current||!r.signals.capture||r.signals.capture<=last)return false;
  last=r.signals.capture;++calls.used;return true;
 }
 void InvalidateSources(){context.reset();last=0;++calls.invalidated;}
};
static FakeStatus status;
static FakeStatus& GetVulkanPresentStatus(){return status;}
struct VkPresentPrivateFrame {
 VkPresentImageRequest request_;
 VkCommandBuffer commandBuffer_=Handle<VkCommandBuffer>(9);
 bool Ready()const{return true;}
 bool Check(const VkPresentImageRequest&);
 std::optional<VkPresentInitializationRequest> InitializationRequest(const VkPresentImageRequest& image,std::string& reason){
  if(!Check(image)){reason="frame mismatch";return {};}
  return VkPresentInitializationRequest{};
 }
 VkCommandBuffer CommandBuffer()const{return commandBuffer_;}
 void Release(bool){++calls.release;}
 bool DiscardCapturedGuides(){++calls.discard;return discardOkay;}
};
// PRODUCTION_PRIVATE_FRAME_CHECK
static void AbandonPresentRecordingVk(bool){++calls.abandon;}
static void MarkPresentRuntimeUncertainVk(const char*){}
static VkPresentRecordResult RecordVkPresentImage(const VkPresentImageRequest& r,VkPresentPrivateFrame& frame,bool reset){
 assert(frame.Check(r));++calls.record;calls.historyReset=reset;calls.initializationCompleted=frame.request_.initializationCompleted;
 if(r.guides)++calls.bind;
 if(r.capturedGuides){++calls.bind;assert(r.capturedGuides->bind(VkNrUseId{1}));}
 VkPresentRecordResult out;out.status=partial?VkRecordStatus::Partial:VkRecordStatus::Complete;
 out.modelRecorded=true;out.targetWriteRecorded=!preparation;out.requestedPasses=2;
 out.completedPasses=preparation?0:partial?1:2;out.outputVersion=preparation?0:10;out.chainDeliverable=!preparation&&!partial;out.preparationOnly=preparation;
 if(!omitRecordedLifetime)out.modelLifetime=liveModel;
 if(changeAtRecord)++policy.revision;ApplyInitializationMutation(mutateDuringRecord);return out;
}
