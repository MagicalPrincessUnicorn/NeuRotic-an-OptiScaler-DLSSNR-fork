static VkResult VKAPI_CALL vkGetFenceStatusFake(VkDevice,VkFence){return fenceResult;}
static VkResult VKAPI_CALL vkWaitForFencesFake(VkDevice,uint32_t,const VkFence*,VkBool32,uint64_t){return fenceResult;}
static VkResult vkResetFencesFake(VkDevice,uint32_t,const VkFence*){++calls.reset;ownerReadsAfterReset=0;if(changeAtReset)++policy.revision;return VK_SUCCESS;}
static VkResult vkQueueSubmitFake(VkQueue,uint32_t,const VkSubmitInfo* info,VkFence){
 ++calls.submit;assert(info->waitSemaphoreCount==1&&info->pWaitSemaphores[0]==expectedWait);return submitResult;
}
