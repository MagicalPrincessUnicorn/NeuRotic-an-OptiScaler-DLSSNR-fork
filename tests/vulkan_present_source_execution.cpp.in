static unsigned guideIdentity=1;
static std::optional<VkNrGuideLease> SelectVulkanPresentGuides(const VkNrFrameContract& f,const VkNrGuideSelection*,VkImage){
 if(!nativeGuides)return {};auto frame=f;frame.temporal=VkNrTemporalMetadata{};frame.temporal->color={0,0,16,16};return VkNrGuideLease{frame,1,guideIdentity,{1}};
}
static bool CurrentVulkanPresentGuideLease(const VkNrFrameContract& frame,const VkNrGuideSelection* selection,VkImage image,const VkNrGuideLease& lease){auto current=SelectVulkanPresentGuides(frame,selection,image);return current&&current->sourceUse==lease.sourceUse&&current->images==lease.images;}
static std::optional<VkNrFrameContract> SelectVulkanResolutionMetadata(const VkNrFrameContract& f,const VkNrGuideSelection*){if(!nativeGuides)return {};auto frame=f;frame.temporal=VkNrTemporalMetadata{};frame.temporal->color={0,0,16,16};return frame;}
struct VkNrAcquireProof {VkNrUseId use{1};VkDevice device=Handle<VkDevice>(1);uint64_t deviceGeneration=1,swapchainGeneration=2;bool Complete()const{return consumerComplete;}};
struct FakeRegistry {
 std::shared_ptr<const VkNrAcquireProof> proof=std::make_shared<VkNrAcquireProof>();
 std::shared_ptr<const VkNrAcquireProof> AcquireProof(VkSwapchainKHR,uint32_t,uint64_t){return proof;}
 bool IsSwapchainImage(VkDevice,VkImage){return true;}
};
static FakeRegistry& GetVulkanPresentRegistry(){static FakeRegistry r;return r;}
static FakeRegistry& GetVulkanApplicationPresentRegistry(){return GetVulkanPresentRegistry();}
