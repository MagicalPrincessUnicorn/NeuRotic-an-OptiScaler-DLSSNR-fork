template<class T> struct Field { T value{};T value_or_default()const{return value;} };
struct Config {
 Field<uint32_t> DlssNrRoute{1},DlssNrEnhancedResolution{1},DlssNrEnhancedCustomScale{},DlssNrPresentResolution{1},DlssNrPresentCustomScale{};
 Field<bool> DlssNrVulkanPresentSameFrameInit{false},DlssNrHoldFrame{false};
 uint64_t revision=9;bool enabled=true;
 struct Runtime {bool enabled;};
 Runtime GetDlssNrRuntimeSnapshot()const{return {enabled};}
 uint64_t ObservationRevision()const{return revision;}
 static Config* Instance(){static Config c;return &c;}
};
template<class T> struct NrConfigSnapshot:T {bool IsPrivateDiagnostic()const{return false;}};
static std::optional<NrConfigSnapshot<Config>> TryNrConfigSnapshot(const Config& cfg){NrConfigSnapshot<Config> snapshot;static_cast<Config&>(snapshot)=cfg;return snapshot;}
