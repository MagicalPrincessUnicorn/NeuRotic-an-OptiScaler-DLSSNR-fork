static bool changeLifetimeAtProvider=false,changeLifetimeAtActualSubmit=false;
static int ownerReadsAfterReset=0;
static std::optional<VkNrPresentModelLifetime> liveModel;
std::optional<VkNrPresentModelLifetime> CurrentVulkanPresentModelLifetimeVk(){
 if(changeLifetimeAtActualSubmit&&calls.reset&&++ownerReadsAfterReset==2)++liveModel->inputInterruptionEpoch;
 return liveModel;
}
