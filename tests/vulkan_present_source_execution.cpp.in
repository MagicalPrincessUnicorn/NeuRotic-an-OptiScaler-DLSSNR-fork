static constexpr uint64_t kMaximumPrivateBytes=1536ull*1024*1024;
VulkanPresentExecutor::Slot* VulkanPresentExecutor::Create(const VkObservedPresent& o,VkInstance){
 auto s=std::make_unique<Slot>();s->ticket=++nextTicket_;s->generation=o.request.swapchainGeneration;s->deviceGeneration=o.request.deviceGeneration;
 s->device=o.device;s->queue=o.queue;s->swapchain=o.swapchain;s->imageIndex=o.request.imageIndex;s->applicationFacing=o.applicationFacing;
 s->frame=std::make_unique<VkPresentPrivateFrame>();s->signal=Handle<VkSemaphore>(10);s->fence=Handle<VkFence>(11);
 s->frame->request_.image=o.image;s->frame->request_.format=o.request.format;
 s->frame->request_.colorSpace=o.request.colorSpace;s->frame->request_.generation=o.request.swapchainGeneration;s->frame->request_.extent=o.request.extent;
 auto p=s.get();slots_.push_back(std::move(s));return p;
}
void VulkanPresentExecutor::Destroy(Slot&,bool){}
void VulkanPresentExecutor::Shutdown(bool){}
void VulkanPresentExecutor::ReleaseCompletedSupersededFrames(const VkObservedPresent&){}
void VulkanPresentExecutor::RetirePredecessors(const VkObservedPresent&,uint64_t){}
// PRODUCTION_FIND
// PRODUCTION_COMPLETION
// PRODUCTION_INVALIDATE
// PRODUCTION_BEFORE_PRESENT
// PRODUCTION_ORIGINAL_RETURNED
static VkObservedPresent Observed(bool app=true){
 VkObservedPresent o;o.applicationFacing=app;o.device=Handle<VkDevice>(1);o.queue=Handle<VkQueue>(2);o.swapchain=Handle<VkSwapchainKHR>(3);o.image=Handle<VkImage>(4);
 auto& r=o.request;r.enabled=true;r.route=1;r.extent={32,32};r.arrayLayers=1;r.format=VK_FORMAT_R8G8B8A8_UNORM;r.colorSpace=VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
 r.imageUsage=VK_IMAGE_USAGE_TRANSFER_SRC_BIT|VK_IMAGE_USAGE_TRANSFER_DST_BIT;r.swapchainCount=1;r.imageIndex=0;r.acquiredObserved=true;
 r.deviceGeneration=1;r.swapchainGeneration=2;r.acquireGeneration=3;
 auto& c=o.capabilities;c.deviceObserved=c.modelExtensionsEnabled=c.routePreparedAtDeviceCreation=c.surfaceUsageKnown=c.swapchainPNextKnown=c.swapchainObserved=c.imagesObserved=c.queueObserved=c.queueFamilyMatches=c.presentQueueAccessQualified=true;
 c.surfaceUsage=r.imageUsage;c.imageCount=1;c.queueFlags=VK_QUEUE_GRAPHICS_BIT|VK_QUEUE_COMPUTE_BIT;c.deviceGeneration=1;c.swapchainGeneration=2;return o;
}
static std::shared_ptr<VkCapturedGuideInput> Captured(const VkObservedPresent& o){
 auto c=std::make_shared<VkCapturedGuideInput>();auto& i=c->identity;i.device=1;i.deviceGeneration=1;i.swapchain=3;i.swapchainGeneration=2;i.acquisition=o.request.acquireGeneration;
 i.image=4;i.stream=1;i.capture=2;i.previous=1;i.width=32;i.height=32;i.completed=true;c->lease=std::make_shared<int>(0);c->bind=[](VkNrUseId){return true;};return c;
}
static void Reset(){fixtureBudget.reset();fixtureNow={};*Config::Instance()={};initializationCalls=initializationMutation=mutateDuringRecord=mutateDuringProvider=0;initializationStatus=VkPresentInitializationStatus::Ready;guideIdentity=1;queueValid=true;FinalFallback::inputInterruptionEpoch=0;calls={};policy={};policy.revision=9;nativeGuides=true;changeAtRecord=false;discardOkay=true;consumerComplete=true;preparation=partial=false;fenceResult=submitResult=VK_SUCCESS;status={};liveModel=VkNrPresentModelLifetime{1,1,50,0,0};changeAtProvider=changeAtReset=providerFails=omitRecordedLifetime=false;changeLifetimeAtProvider=changeLifetimeAtActualSubmit=false;ownerReadsAfterReset=0;}
static VkPresentExecution Run(VulkanPresentExecutor& e,const VkObservedPresent& o,std::shared_ptr<const VkCapturedGuideInput> captured={}){
 expectedWait=Handle<VkSemaphore>(12);VkPresentInfoKHR original{VK_STRUCTURE_TYPE_PRESENT_INFO_KHR};original.waitSemaphoreCount=1;original.pWaitSemaphores=&expectedWait;
 const auto saved=expectedWait;auto r=e.BeforePresent(o,{},original,{},{},fixtureBudget,[](uint64_t revision /* FIXTURE_CALLBACK_LIFETIME */){assert(revision==policy.revision);++calls.forward;if(changeAtProvider)++policy.revision;ApplyInitializationMutation(mutateDuringProvider);if(changeLifetimeAtProvider)++liveModel->resumeGeneration;VkPresentProviderPreparation p;p.prepared=!providerFails;p.effects=VkProviderPrepareEffects::ExternalEntered;return p;},captured);
 assert(expectedWait==saved&&original.waitSemaphoreCount==1&&original.pWaitSemaphores==&expectedWait);return r;
}
}
int main(){using namespace DlssNr;using Connections::Source;
 for(auto color:{0,1,2})for(bool guided:{false,true})for(bool fg:{false,true}){
  Reset();nativeGuides=guided;auto o=Observed();
  o.request.fgKnownActive=fg;
  if(color==1){o.request.format=VK_FORMAT_A2B10G10R10_UNORM_PACK32;o.request.colorSpace=VK_COLOR_SPACE_HDR10_ST2084_EXT;}
  if(color==2){o.request.format=VK_FORMAT_R16G16B16A16_SFLOAT;o.request.colorSpace=VK_COLOR_SPACE_EXTENDED_SRGB_LINEAR_EXT;}
  VulkanPresentExecutor e;auto r=Run(e,o);assert(r.ticket&&calls.record==1&&calls.submit==1&&calls.forward==1&&calls.bind==int(guided));
  assert(r.sources.completeTarget&&calls.used==0);e.ObserveSlotCompletion(*e.slots_.front());assert(calls.used==1); // GPU completion is explicit
 }
 Reset();{VulkanPresentExecutor e;policy.strict=true;policy.color=Source::External;auto r=Run(e,Observed());assert(!r.ticket&&calls.record==0&&calls.bind==0&&calls.forward==0&&calls.reset==0&&calls.submit==0);}
 Reset();{VulkanPresentExecutor e;auto o=Observed();o.request.policy=PresentInput::Policy::ImageOnly;auto r=Run(e,o);assert(r.ticket&&!calls.bind&&!r.sources.signals.depth&&!r.sources.signals.motion);}
 Reset();{VulkanPresentExecutor e;auto o=Observed();o.capabilities.queueFlags=VK_QUEUE_GRAPHICS_BIT;auto r=Run(e,o);assert(!r.ticket&&!calls.record&&!calls.forward&&!calls.submit);}
 Reset();{VulkanPresentExecutor e;auto o=Observed();o.request.colorSpace=VK_COLOR_SPACE_HDR10_ST2084_EXT;auto r=Run(e,o);assert(!r.ticket&&!calls.record&&!calls.forward&&!calls.submit);}
 Reset();{VulkanPresentExecutor e;policy.strict=true;policy.depth=Source::External;auto o=Observed();o.request.policy=PresentInput::Policy::RequireGuides;auto r=Run(e,o);assert(r.ticket&&calls.bind==0&&r.admission.actualInputClass==PresentInputDecision::InputClass::ImageOnly&&!r.sources.signals.depth&&!r.sources.signals.motion);}
 for(bool captured:{false,true}){
  Reset();auto o=Observed(!captured);VulkanPresentExecutor e;auto c=captured?Captured(o):nullptr;
  if(captured){policy.strict=true;policy.depth=policy.motion=Source::BuiltIn;}
  auto good=Run(e,o,c);assert(good.ticket&&calls.submit==1&&calls.bind==1);
  e.OriginalPresentReturned(good.ticket,VK_SUCCESS);++o.request.acquireGeneration;if(c)c->identity.acquisition=o.request.acquireGeneration;
  calls={};changeAtRecord=true;auto refused=Run(e,o,c);
  assert(!refused.ticket&&calls.record==1&&calls.forward==0&&calls.reset==0&&calls.submit==0&&calls.release==0);
  assert(captured?calls.discard==1&&calls.abandon==0:calls.abandon==1&&calls.discard==0);
 }
 Reset();{auto o=Observed(false);VulkanPresentExecutor e;policy.strict=true;policy.depth=Source::Native;auto r=Run(e,o,Captured(o));assert(!r.ticket&&!calls.record&&!calls.bind&&!calls.forward&&!calls.submit);}
 Reset();{auto o=Observed(false);VulkanPresentExecutor e;auto c=Captured(o);++c->identity.acquisition;auto r=Run(e,o,c);assert(!r.ticket&&!calls.record&&!calls.bind&&!calls.submit);}
 Reset();{auto o=Observed(false);VulkanPresentExecutor e;changeAtRecord=true;discardOkay=false;auto r=Run(e,o,Captured(o));assert(r.handoff.state==VkPresentHandoffState::Uncertain&&calls.discard==1&&e.slots_.front()->state.Pending()&&!calls.submit&&!calls.release);}
 Reset();{auto o=Observed();VulkanPresentExecutor e;auto a=Run(e,o);e.OriginalPresentReturned(a.ticket,VK_SUCCESS);fenceResult=VK_NOT_READY;++o.request.acquireGeneration;calls={};auto b=Run(e,o);assert(!b.ticket&&!calls.record&&!calls.used&&!calls.release);}
 Reset();{auto o=Observed();VulkanPresentExecutor e;auto a=Run(e,o);e.OriginalPresentReturned(a.ticket,VK_SUCCESS);consumerComplete=false;++o.request.acquireGeneration;calls={};auto b=Run(e,o);assert(!b.ticket&&calls.used==1&&!calls.record&&!calls.release);}
 Reset();{auto o=Observed();VulkanPresentExecutor e;auto a=Run(e,o);e.OriginalPresentReturned(a.ticket,VK_SUCCESS);++o.request.acquireGeneration;calls={};auto b=Run(e,o);assert(b.ticket==a.ticket&&b.sources.signals.capture>a.sources.signals.capture&&b.sources.acquisition!=a.sources.acquisition);}
 Reset();{auto o=Observed();VulkanPresentExecutor e;preparation=true;auto r=Run(e,o);assert(r.ticket&&!r.sources.completeTarget&&!calls.forward);e.ObserveSlotCompletion(*e.slots_.front());assert(!calls.used);}
 Reset();{VulkanPresentExecutor e;partial=true;auto r=Run(e,Observed());assert(!r.ticket&&!calls.submit&&!calls.used);}
 Reset();{VulkanPresentExecutor e;auto r=Run(e,Observed());auto& slot=*e.slots_.front();slot.sources.acquisition++;calls={};e.ObserveSlotCompletion(slot);assert(!calls.used);}
 Reset();{VulkanPresentExecutor e;submitResult=VK_ERROR_DEVICE_LOST;auto r=Run(e,Observed());assert(r.handoff.state==VkPresentHandoffState::Uncertain&&!r.ticket&&!calls.used&&e.slots_.front()->state.Pending());}
 Reset();{auto o=Observed();VulkanPresentExecutor e;auto a=Run(e,o);e.OriginalPresentReturned(a.ticket,VK_SUCCESS);auto context=e.sourceContext_;auto capture=e.nextSourceCapture_;o.applicationFacing=false;o.request.fgKnownActive=true;calls={};auto b=Run(e,o);assert(!b.ticket&&e.sourceContext_==context&&e.nextSourceCapture_==capture&&!calls.record&&!calls.used);}
 Reset();{auto o=Observed();VulkanPresentExecutor e;auto a=Run(e,o);e.OriginalPresentReturned(a.ticket,VK_SUCCESS);fenceResult=VK_ERROR_DEVICE_LOST;++o.request.acquireGeneration;calls={};auto b=Run(e,o);assert(!b.ticket&&!calls.record&&!calls.used&&!calls.release);}
 // VK002: production captured caller is the physical boundary.
 Reset();{auto o=Observed(false);o.request.policy=PresentInput::Policy::Invalid;VulkanPresentExecutor e;
  auto r=Run(e,o,Captured(o));assert(!r.ticket&&!calls.bind&&!calls.record&&!calls.forward&&!calls.reset&&!calls.submit);}
 // VK001: recycled old fence remains signaled, but supplies no new completion.
 Reset();{auto o=Observed();VulkanPresentExecutor e;auto a=Run(e,o);e.OriginalPresentReturned(a.ticket,VK_SUCCESS);
  ++o.request.acquireGeneration;calls={};changeAtProvider=true;auto r=Run(e,o);
  assert(r.handoff.state==VkPresentHandoffState::Uncertain&&!r.ticket&&e.closed_);
  assert(calls.forward==1&&!calls.reset&&!calls.submit&&!calls.abandon&&!calls.discard&&!calls.release);
  auto& s=*e.slots_.front();assert(s.consumer&&s.frame&&s.state.Pending()&&s.completionObserved);
  assert(s.sources.signals.capture==a.sources.signals.capture&&!s.retirementProven);
  calls={};e.ObserveSlotCompletion(s);assert(!calls.used);auto next=Run(e,o);assert(!next.ticket&&!calls.record&&!calls.submit);}
 Reset();{auto o=Observed();VulkanPresentExecutor e;providerFails=true;auto r=Run(e,o);
  assert(r.handoff.state==VkPresentHandoffState::Uncertain&&e.closed_&&calls.forward==1&&!calls.reset&&!calls.submit&&!calls.abandon&&e.slots_.front()->consumer);}
 Reset();{auto o=Observed();VulkanPresentExecutor e;auto a=Run(e,o);e.OriginalPresentReturned(a.ticket,VK_SUCCESS);
  ++o.request.acquireGeneration;calls={};changeAtReset=true;auto r=Run(e,o);
  assert(r.handoff.state==VkPresentHandoffState::Uncertain&&calls.forward==1&&calls.reset==1&&!calls.submit&&!calls.release&&e.slots_.front()->consumer);}
 // VK004: an unknown or missing recorded owner identity never qualifies output.
 Reset();{VulkanPresentExecutor e;omitRecordedLifetime=true;auto r=Run(e,Observed());assert(!r.ticket&&calls.abandon==1&&!calls.forward&&!calls.reset&&!calls.submit);}
 Reset();{auto o=Observed();VulkanPresentExecutor e;auto a=Run(e,o);++liveModel->routeEpoch;
  e.ObserveSlotCompletion(*e.slots_.front());assert(!calls.used);e.OriginalPresentReturned(a.ticket,VK_SUCCESS);
  ++o.request.acquireGeneration;auto b=Run(e,o);assert(b.ticket&&b.sources.context.modelLifetime==liveModel&&b.sources.context.routeEpoch==liveModel->routeEpoch);
