static bool acquireComplete=false, fixtureFgKnown=false, fixtureFgOn=false, queueQualified=true;
static uint64_t acquisition=1; static uint64_t observedImageBase=10;
static uint64_t fixtureSwapchainGeneration=1;
static std::vector<uint64_t> fixtureAncestors;
namespace DlssNr {
struct VkNrAcquireProof {
 VkDevice device{}; uint64_t deviceGeneration=1,swapchainGeneration=1,acquireGeneration=0;
 VkSwapchainKHR swapchain{}; uint32_t imageIndex=0; uint64_t priorPresentSerial=0;
 VkQueue priorPresentQueue{}; std::vector<uint64_t> predecessorGenerations;
 bool completed=false; bool Complete()const{return completed;}
};
static uint64_t fixtureSerial=0;
static unsigned polls=0;
static std::vector<std::shared_ptr<VkNrAcquireProof>> proofs;
static unsigned completeAfterPolls=0;
void PollVkNrCompletions(){++polls;if(completeAfterPolls&&polls>=completeAfterPolls)for(auto& p:proofs)p->completed=true;}
struct VkObservedPresent {
 struct {bool queueObserved=true,presentQueueAccessQualified=true,swapchainPNextKnown=true;VkQueueFlags queueFlags=VK_QUEUE_GRAPHICS_BIT;} capabilities;
 struct {uint32_t imageIndex=0;bool acquiredObserved=true,fgStateKnown=false,fgKnownActive=false;uint64_t acquireGeneration=1,deviceGeneration=1,swapchainGeneration=1;VkSwapchainCreateFlagsKHR flags=0;VkImageUsageFlags imageUsage=VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT|VK_IMAGE_USAGE_TRANSFER_SRC_BIT;VkFormat format=VK_FORMAT_R8G8B8A8_UNORM;VkColorSpaceKHR colorSpace=VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;VkExtent2D extent{1280,720};unsigned arrayLayers=1;} request;
 VkQueue queue{};VkDevice device{};VkSwapchainKHR swapchain{};VkPhysicalDevice physicalDevice{};uint32_t queueFamily=7;VkImage image{};
};
std::optional<int> VkNrRecordingQueueContext(VkDevice,uint32_t,VkQueue){return queueQualified?std::optional<int>(1):std::nullopt;}
class VulkanPresentRegistry {public:
 bool AcquireConsumed(VkSwapchainKHR,uint32_t,uint64_t expected){return acquireComplete&&expected==acquisition;}
 std::shared_ptr<const VkNrAcquireProof> AcquireProof(VkSwapchainKHR swap,uint32_t index,uint64_t gen){
  if(!gen)return {}; for(auto& p:proofs)if(p->swapchain==swap&&p->imageIndex==index&&p->acquireGeneration==gen){if(acquireComplete)p->completed=true;return p;}
  auto p=std::make_shared<VkNrAcquireProof>();p->device=reinterpret_cast<VkDevice>(1);p->swapchain=swap;p->swapchainGeneration=fixtureSwapchainGeneration;p->predecessorGenerations=fixtureAncestors;p->imageIndex=index;p->acquireGeneration=gen;p->completed=acquireComplete;p->priorPresentSerial=fixtureSerial;p->priorPresentQueue=reinterpret_cast<VkQueue>(4);proofs.push_back(p);return p;
 }
 uint64_t LastPresentSerial(VkSwapchainKHR,uint32_t)const{return fixtureSerial;}
};
VulkanPresentRegistry& GetVulkanPresentRegistry(){static VulkanPresentRegistry r;return r;}
}
namespace MenuOverlayVk {
VkResult CompositeGenerated(const std::unique_lock<std::mutex>&,VkSwapchainKHR,VkCommandBuffer,VkImage,unsigned,unsigned);
void GeneratedPresentationFinished(const std::unique_lock<std::mutex>&,VkResult);
struct BoundaryContext{uint64_t generation=0;DlssNr::VulkanPresentRegistry* registry=nullptr;PFN_vkGetSwapchainImagesKHR getImages=nullptr;}; enum class QueuePresentStatus {Bypassed,Accepted,FailedBeforeSubmit,SubmitUncertain}; using PresentLock=std::unique_lock<std::mutex>; PresentLock LockPresent(); void Unavailable(); void Presented(const PresentLock&,bool,BoundaryContext boundary={}); QueuePresentStatus QueuePresent(VkQueue,VkPresentInfoKHR*,const PresentLock&,const DlssNr::VkObservedPresent*,BoundaryContext boundary={}); void DestroyVulkanObjects(bool); void ShutdownDevice(VkDevice); void ShutdownSwapchain(VkDevice,VkSwapchainKHR); void NotifyDeviceDestroyed(VkDevice); void CreateSwapchain(VkDevice,VkPhysicalDevice,VkInstance,HWND,const VkSwapchainCreateInfoKHR*,const VkAllocationCallbacks*,VkSwapchainKHR*,BoundaryContext boundary={}); }
static std::map<uint64_t,std::string> live;
static std::vector<std::string> events;
static uint64_t nextHandle=100;
static unsigned imageCount=3, queueCount=1, imageFillCalls=0, guessedQueueCalls=0;
static bool badCaptureOrder=false,badWaitStage=false,badFenceReset=false,needPoll=false;static unsigned waitPollBaseline=0;
static bool incompleteImages=false, failedFramebuffer=false, growQueues=false;
static VkResult idleResult=VK_SUCCESS, submitResult=VK_SUCCESS, fenceResult=VK_SUCCESS,endResult=VK_SUCCESS;
static uint64_t fenceTimeout=0;
static std::atomic<unsigned> idleCalls=0, submitCalls=0;
static std::mutex submitMutex;
static std::condition_variable submitCv;
static bool blockSubmit=false, enteredSubmit=false, releaseSubmit=false;
static bool blockEnumeration=false, enteredEnumeration=false, releaseEnumeration=false;
static bool backendDestroyedBeforeIdle=false;
template<class T> T handle(uint64_t n){return reinterpret_cast<T>(n);}
template<class T> T create(const char* name){auto n=++nextHandle;live[n]=name;return handle<T>(n);}
template<class T> void destroy(T h,const char* name){auto n=reinterpret_cast<uint64_t>(h);if(!live.erase(n))throw std::runtime_error("double or unknown destroy");events.push_back(name);}
static size_t count(const char* name){return std::count_if(live.begin(),live.end(),[&](auto& x){return x.second==name;});}
VKAPI_ATTR VkResult VKAPI_CALL vkDeviceWaitIdle(VkDevice){++idleCalls;events.push_back("idle");return idleResult;}
VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL vkGetInstanceProcAddr(VkInstance,const char*){return nullptr;}
VKAPI_ATTR VkResult VKAPI_CALL vkGetSwapchainImagesKHR(VkDevice,VkSwapchainKHR,uint32_t* n,VkImage* out){if(blockEnumeration){std::unique_lock lock(submitMutex);enteredEnumeration=true;submitCv.notify_all();submitCv.wait(lock,[]{return releaseEnumeration;});}if(!out){*n=imageCount;return VK_SUCCESS;}++imageFillCalls;if(incompleteImages&&imageFillCalls==1){*n=0;return VK_INCOMPLETE;}auto written=std::min(*n,imageCount);for(unsigned i=0;i<written;++i)out[i]=handle<VkImage>(10+i);*n=written;return VK_SUCCESS;}
VKAPI_ATTR void VKAPI_CALL vkGetPhysicalDeviceQueueFamilyProperties(VkPhysicalDevice,uint32_t* n,VkQueueFamilyProperties* out){if(!out){*n=queueCount;return;}auto written=std::min(*n,queueCount);for(unsigned i=0;i<written;++i){out[i]={};out[i].queueFlags=(!growQueues || i==11)?VK_QUEUE_GRAPHICS_BIT:0;out[i].queueCount=1;}*n=written;if(growQueues)queueCount=12;}
VKAPI_ATTR void VKAPI_CALL vkGetDeviceQueue(VkDevice,uint32_t,uint32_t,VkQueue* q){++guessedQueueCalls;*q=handle<VkQueue>(4);}
#define CREATE(Name, Type, Info) VKAPI_ATTR VkResult VKAPI_CALL vkCreate##Name(VkDevice,const Info*,const VkAllocationCallbacks*,Type* out){*out=create<Type>(#Name);return VK_SUCCESS;}
CREATE(DescriptorPool,VkDescriptorPool,VkDescriptorPoolCreateInfo)
CREATE(RenderPass,VkRenderPass,VkRenderPassCreateInfo)
CREATE(ImageView,VkImageView,VkImageViewCreateInfo)
CREATE(CommandPool,VkCommandPool,VkCommandPoolCreateInfo)
CREATE(Fence,VkFence,VkFenceCreateInfo)
CREATE(Semaphore,VkSemaphore,VkSemaphoreCreateInfo)
VKAPI_ATTR VkResult VKAPI_CALL vkCreateFramebuffer(VkDevice,const VkFramebufferCreateInfo*,const VkAllocationCallbacks*,VkFramebuffer* out){if(failedFramebuffer)return VK_ERROR_OUT_OF_DEVICE_MEMORY;*out=create<VkFramebuffer>("Framebuffer");return VK_SUCCESS;}
#define DESTROY(Name,Type) VKAPI_ATTR void VKAPI_CALL vkDestroy##Name(VkDevice,Type h,const VkAllocationCallbacks*){destroy(h,#Name);}
DESTROY(DescriptorPool,VkDescriptorPool) DESTROY(RenderPass,VkRenderPass) DESTROY(ImageView,VkImageView) DESTROY(Framebuffer,VkFramebuffer) DESTROY(CommandPool,VkCommandPool) DESTROY(Fence,VkFence) DESTROY(Semaphore,VkSemaphore)
VKAPI_ATTR VkResult VKAPI_CALL vkAllocateCommandBuffers(VkDevice,const VkCommandBufferAllocateInfo*,VkCommandBuffer* out){*out=create<VkCommandBuffer>("CommandBuffer");return VK_SUCCESS;}
VKAPI_ATTR void VKAPI_CALL vkFreeCommandBuffers(VkDevice,VkCommandPool,uint32_t n,const VkCommandBuffer* out){for(unsigned i=0;i<n;++i)destroy(out[i],"CommandBuffer");}
VKAPI_ATTR VkResult VKAPI_CALL vkResetCommandPool(VkDevice,VkCommandPool,VkCommandPoolResetFlags){return VK_SUCCESS;}
VKAPI_ATTR VkResult VKAPI_CALL vkBeginCommandBuffer(VkCommandBuffer,const VkCommandBufferBeginInfo*){return VK_SUCCESS;}
VKAPI_ATTR VkResult VKAPI_CALL vkEndCommandBuffer(VkCommandBuffer){return endResult;}
VKAPI_ATTR VkResult VKAPI_CALL vkQueueSubmit(VkQueue,uint32_t,const VkSubmitInfo* info,VkFence){for(unsigned i=0;i<info->waitSemaphoreCount;++i)if(!(info->pWaitDstStageMask[i]&VK_PIPELINE_STAGE_ALL_COMMANDS_BIT))badWaitStage=true;++submitCalls;std::unique_lock lock(submitMutex);if(blockSubmit){enteredSubmit=true;submitCv.notify_all();submitCv.wait(lock,[]{return releaseSubmit;});}return submitResult;}
VKAPI_ATTR VkResult VKAPI_CALL vkWaitForFences(VkDevice,uint32_t,const VkFence*,VkBool32,uint64_t timeout){fenceTimeout=timeout;using namespace Neurotic::Semantic::Character;if(fenceResult==VK_SUCCESS&&inspectorPolls){needPoll=true;waitPollBaseline=inspectorPolls;}return fenceResult;}
VKAPI_ATTR VkResult VKAPI_CALL vkResetFences(VkDevice,uint32_t,const VkFence*){if(needPoll&&Neurotic::Semantic::Character::inspectorPolls<=waitPollBaseline)badFenceReset=true;needPoll=false;return VK_SUCCESS;}
VKAPI_ATTR void VKAPI_CALL vkCmdBeginRenderPass(VkCommandBuffer,const VkRenderPassBeginInfo*,VkSubpassContents){if(Neurotic::Semantic::Character::inspectorRecords && !Neurotic::Semantic::Character::inspectorPending)badCaptureOrder=true;}
VKAPI_ATTR void VKAPI_CALL vkCmdEndRenderPass(VkCommandBuffer){}
bool ImGui_ImplVulkan_Init(ImGui_ImplVulkan_InitInfo*){fixtureIo.BackendRendererUserData=(void*)1;return true;}
void ImGui_ImplVulkan_Shutdown(bool){if(events.empty()||events.back()!="idle")backendDestroyedBeforeIdle=true;fixtureIo.BackendRendererUserData=nullptr;events.push_back("backend");}
void ImGui_ImplVulkan_NewFrame(){}
static unsigned overlayDraws=0, overlayBarriers=0;
void ImGui_ImplVulkan_RenderDrawData(void*,VkCommandBuffer){++overlayDraws;}
VKAPI_ATTR void VKAPI_CALL vkCmdPipelineBarrier(VkCommandBuffer,VkPipelineStageFlags,VkPipelineStageFlags,VkDependencyFlags,uint32_t,const VkMemoryBarrier*,uint32_t,const VkBufferMemoryBarrier*,uint32_t count,const VkImageMemoryBarrier* barriers){if(count==1&&barriers->image==handle<VkImage>(11))++overlayBarriers;}
// PRODUCTION_OVERLAY
static VkResult VKAPI_CALL alternateImages(VkDevice device,VkSwapchainKHR swap,uint32_t* count,VkImage* images){auto result=vkGetSwapchainImagesKHR(device,swap,count,images);if(images)for(uint32_t i=0;i<*count;++i)images[i]=handle<VkImage>(110+i);return result;}
static auto observation(VkQueue q,VkPresentInfoKHR* info) {DlssNr::VkObservedPresent o;o.queue=q;o.device=handle<VkDevice>(1);o.physicalDevice=handle<VkPhysicalDevice>(2);o.swapchain=info->pSwapchains[0];o.request.imageIndex=info->pImageIndices[0];o.request.acquireGeneration=acquisition;o.request.swapchainGeneration=fixtureSwapchainGeneration;o.request.fgStateKnown=fixtureFgKnown;o.request.fgKnownActive=fixtureFgOn;o.image=handle<VkImage>(observedImageBase+o.request.imageIndex);return o;}
static auto draw(VkQueue q,VkPresentInfoKHR* info,MenuOverlayVk::BoundaryContext boundary={}) {auto guard=MenuOverlayVk::LockPresent();auto o=observation(q,info);auto result=MenuOverlayVk::QueuePresent(q,info,guard,&o,boundary);if(result==MenuOverlayVk::QueuePresentStatus::Accepted){++DlssNr::fixtureSerial;MenuOverlayVk::Presented(guard,true,boundary);}return result;}
static void require(bool ok,const char* message){if(!ok)throw std::runtime_error(message);}
static void make(MenuOverlayVk::BoundaryContext boundary={}){VkSwapchainCreateInfoKHR info{};info.imageExtent={1280,720};info.minImageCount=2;info.imageUsage=VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT|VK_IMAGE_USAGE_TRANSFER_SRC_BIT;info.imageFormat=VK_FORMAT_R8G8B8A8_UNORM;auto swap=handle<VkSwapchainKHR>(5);MenuOverlayVk::CreateSwapchain(handle<VkDevice>(1),handle<VkPhysicalDevice>(2),handle<VkInstance>(3),(HWND)1,&info,nullptr,&swap,boundary);VkPresentInfoKHR present{};uint32_t index=0;present.swapchainCount=1;present.pSwapchains=&swap;present.pImageIndices=&index;renderEnabled=false;draw(handle<VkQueue>(4),&present,boundary);renderEnabled=true;}
int main(int argc,char** argv){try{
 const std::string mode=argc>1?argv[1]:"recreate";
 if(mode=="fg-startup-no-idle") {
  fixtureFgKnown=true;fixtureFgOn=true;
  // Provider work may be waiting for this intercepted Present to return.
  // make() initializes with overlay drawing disabled: no upload is needed.
  make();
  require(_vulkanObjectsCreated&&_isInited,"FG startup did not initialize the overlay");
  require(idleCalls==0,"overlay startup drains the device inside provider Present");
  require(submitCalls==0,"overlay startup submitted an empty upload");
  auto swap=handle<VkSwapchainKHR>(5);uint32_t index=0;auto wait=handle<VkSemaphore>(990);
  VkPresentInfoKHR present{VK_STRUCTURE_TYPE_PRESENT_INFO_KHR,nullptr,1,&wait,1,&swap,&index};
  require(draw(handle<VkQueue>(4),&present)==MenuOverlayVk::QueuePresentStatus::Accepted,"first FG overlay draw failed");
  require(submitCalls==1&&idleCalls==0,"first draw did not use just its fenced submission");
  require(present.waitSemaphoreCount==1&&*present.pWaitSemaphores!=wait,"first draw lost the replacement wait");
  MenuOverlayVk::DestroyVulkanObjects(false);
  require(idleCalls==1&&!backendDestroyedBeforeIdle,"startup repair removed teardown lifetime protection");
 }
 if(mode=="generated-overlay") {
  make();auto swap=handle<VkSwapchainKHR>(5);uint32_t index=0;
  VkPresentInfoKHR present{VK_STRUCTURE_TYPE_PRESENT_INFO_KHR};present.swapchainCount=1;present.pSwapchains=&swap;present.pImageIndices=&index;
  auto guard=MenuOverlayVk::LockPresent();auto observed=observation(handle<VkQueue>(4),&present);
  require(MenuOverlayVk::QueuePresent(handle<VkQueue>(4),&present,guard,&observed)==MenuOverlayVk::QueuePresentStatus::Accepted,"real overlay not submitted");
  const auto before=overlayDraws;
  require(MenuOverlayVk::CompositeGenerated(guard,swap,handle<VkCommandBuffer>(900),handle<VkImage>(11),1280,720)==VK_SUCCESS,"generated overlay missing");
  require(overlayDraws==before+1&&overlayBarriers==2,"overlay not replayed between layout barriers");
  fenceResult=VK_TIMEOUT;
  require(MenuOverlayVk::CompositeGenerated(guard,swap,handle<VkCommandBuffer>(900),handle<VkImage>(11),1280,720)==VK_TIMEOUT&&overlayDraws==before+1,"busy shared UI uploads reused");
  fenceResult=VK_SUCCESS;guard.unlock();
  require(MenuOverlayVk::CompositeGenerated(guard,swap,handle<VkCommandBuffer>(900),handle<VkImage>(11),1280,720)!=VK_SUCCESS,"unpinned backend replayed");
  guard=MenuOverlayVk::LockPresent();
  MenuOverlayVk::GeneratedPresentationFinished(guard,VK_ERROR_OUT_OF_DATE_KHR);
  require(!_vkOverlaySubmissionUncertain,"normal WSI recreation poisoned overlay");
  MenuOverlayVk::GeneratedPresentationFinished(guard,VK_ERROR_DEVICE_LOST);
  require(MenuOverlayVk::QueuePresent(handle<VkQueue>(4),&present,guard,&observed)==MenuOverlayVk::QueuePresentStatus::SubmitUncertain&&overlayDraws==before+1,"uncertain generated submission reused ImGui uploads");
  guard.unlock();
  idleResult=VK_ERROR_DEVICE_LOST;const auto retained=live;MenuOverlayVk::DestroyVulkanObjects(false);
  require(live==retained,"failed idle freed uncertain generated overlay");idleResult=VK_SUCCESS;
  MenuOverlayVk::DestroyVulkanObjects(false);
 }
 if(mode=="inspector-capture"||mode=="inspector-uncertain"||mode=="inspector-busy"||mode=="inspector-end-failure") {
  using namespace Neurotic::Semantic::Character;
  make();auto swap=handle<VkSwapchainKHR>(5);uint32_t index=2;auto wait=handle<VkSemaphore>(990);
  VkPresentInfoKHR caller{VK_STRUCTURE_TYPE_PRESENT_INFO_KHR,nullptr,1,&wait,1,&swap,&index};auto local=caller;
  if(mode=="inspector-uncertain")submitResult=VK_ERROR_DEVICE_LOST;
  if(mode=="inspector-busy")fenceResult=VK_TIMEOUT;
  if(mode=="inspector-end-failure")endResult=VK_ERROR_OUT_OF_HOST_MEMORY;
  const auto beforeSubmit=submitCalls.load();const auto result=draw(handle<VkQueue>(4),&local);
  if(mode=="inspector-end-failure"){
   require(result==MenuOverlayVk::QueuePresentStatus::FailedBeforeSubmit&&inspectorRecords==1&&inspectorSubmits==0&&inspectorCancels==1&&submitCalls==beforeSubmit,"failed recording did not cancel without submitting");
   require(local.pWaitSemaphores==&wait&&local.waitSemaphoreCount==1,"failed recording changed caller waits");
  }else if(mode=="inspector-busy"){
   require(result==MenuOverlayVk::QueuePresentStatus::FailedBeforeSubmit&&inspectorRecords==0&&submitCalls==beforeSubmit,"busy overlay recorded capture or submitted");
   require(local.pWaitSemaphores==caller.pWaitSemaphores&&local.waitSemaphoreCount==1,"busy capture consumed caller waits");
  }else{
   require(inspectorRecords==1&&inspectorSubmits==1&&!badCaptureOrder&&!badWaitStage&&!badFenceReset,"capture ordering, fence binding, or wait stage failed");
   require(inspectorImage==handle<VkImage>(12)&&inspectorFence==_ImVulkan_Frames[2].Fence,"capture borrowed another physical image or completion fence");
   require(inspectorCancels==0,"submitted/uncertain capture cancelled prematurely");
   if(mode=="inspector-uncertain"){
    require(result==MenuOverlayVk::QueuePresentStatus::SubmitUncertain&&local.pWaitSemaphores==&wait,"uncertain capture forwarded a replacement wait");
    idleResult=VK_ERROR_DEVICE_LOST;MenuOverlayVk::ShutdownDevice(handle<VkDevice>(1));require(inspectorReleases==0,"failed idle released live capture");
    MenuOverlayVk::NotifyDeviceDestroyed(handle<VkDevice>(1));require(inspectorAbandons==1,"dead capture handles not abandoned");
   }else{
    require(result==MenuOverlayVk::QueuePresentStatus::Accepted&&local.pWaitSemaphores!=&wait,"successful capture did not forward overlay semaphore");
    MenuOverlayVk::ShutdownDevice(handle<VkDevice>(1));require(inspectorReleases==1,"idle capture not released before owner fence destruction");
   }
  }
