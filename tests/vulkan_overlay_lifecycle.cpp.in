class CharacterCaptureVk {bool ready=false;public:
static std::optional<unsigned> ColorPolicy(VkFormat,VkColorSpaceKHR){return 0u;}
bool Initialize(VkPhysicalDevice,VkDevice,VkFormat,VkColorSpaceKHR,VkExtent2D){ready=true;return true;}
bool Ready(){return ready;}
int Record(VkCommandBuffer,VkImage image,CpuFrame){++inspectorRecords;inspectorImage=image;inspectorPending=true;return 0;}
void Cancel(int index){if(index>=0&&inspectorPending){++inspectorCancels;inspectorPending=false;}}
void Submitted(int index,VkFence fence){if(index>=0){++inspectorSubmits;inspectorFence=fence;inspectorPending=false;}}
std::optional<CpuFrame> Poll(){++inspectorPolls;return {};}
void ReleaseAfterIdle(){if(ready)++inspectorReleases;ready=false;}
void AbandonDestroyedDevice(){if(ready)++inspectorAbandons;ready=false;}
};
