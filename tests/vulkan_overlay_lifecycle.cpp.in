  require(draw(handle<VkQueue>(4),&local)==MenuOverlayVk::QueuePresentStatus::Bypassed,"unknown extension admitted GPU mutation");
  VkDeviceGroupPresentInfoKHR group{VK_STRUCTURE_TYPE_DEVICE_GROUP_PRESENT_INFO_KHR};local.pNext=&group;
  require(draw(handle<VkQueue>(4),&local)==MenuOverlayVk::QueuePresentStatus::Bypassed,"device group extension admitted unsupported device mask");
  uint64_t id=7;VkPresentTimeGOOGLE time{8,9};VkPresentTimesInfoGOOGLE times{VK_STRUCTURE_TYPE_PRESENT_TIMES_INFO_GOOGLE,nullptr,1,&time};
  VkPresentIdKHR ids{VK_STRUCTURE_TYPE_PRESENT_ID_KHR,&times,1,&id};VkFence fence=handle<VkFence>(991);
  VkSwapchainPresentFenceInfoEXT fences{VK_STRUCTURE_TYPE_SWAPCHAIN_PRESENT_FENCE_INFO_EXT,&ids,1,&fence};VkPresentModeKHR modeValue=VK_PRESENT_MODE_FIFO_KHR;
  VkSwapchainPresentModeInfoEXT modes{VK_STRUCTURE_TYPE_SWAPCHAIN_PRESENT_MODE_INFO_EXT,&fences,1,&modeValue};caller.pNext=&modes;local=caller;
  require(draw(handle<VkQueue>(4),&local)==MenuOverlayVk::QueuePresentStatus::Accepted,"benign metadata chain refused");
  require(local.pNext==caller.pNext&&local.pResults==caller.pResults&&caller.pWaitSemaphores==&wait&&caller.waitSemaphoreCount==1&&result==VK_NOT_READY&&id==7&&time.desiredPresentTime==9&&fences.pFences==&fence,"benign chain or caller mutated");
  MenuOverlayVk::ShutdownDevice(handle<VkDevice>(1));MenuOverlayVk::NotifyDeviceDestroyed(handle<VkDevice>(1));
 }
 if(mode=="chain-before-create") {
  VkSwapchainCreateInfoKHR info{};info.imageExtent={1280,720};auto swap=handle<VkSwapchainKHR>(5);
  MenuOverlayVk::CreateSwapchain(handle<VkDevice>(1),handle<VkPhysicalDevice>(2),handle<VkInstance>(3),(HWND)1,&info,nullptr,&swap);
  uint32_t index=0;VkPresentRegionsKHR regions{VK_STRUCTURE_TYPE_PRESENT_REGIONS_KHR};VkPresentInfoKHR present{VK_STRUCTURE_TYPE_PRESENT_INFO_KHR,&regions,0,nullptr,1,&swap,&index};
  require(draw(handle<VkQueue>(4),&present)==MenuOverlayVk::QueuePresentStatus::Bypassed&&live.empty()&&submitCalls==0,"unsupported chain allocated GPU objects before refusal");
 }
 if(mode=="swapchain-shutdown") {
  make();auto before=live;auto calls=idleCalls.load();MenuOverlayVk::ShutdownSwapchain(handle<VkDevice>(99),handle<VkSwapchainKHR>(5));MenuOverlayVk::ShutdownSwapchain(handle<VkDevice>(1),handle<VkSwapchainKHR>(99));
  require(live==before&&idleCalls==calls&&!_vkClosingRequested,"foreign swapchain shutdown touched current owner");
  VkSwapchainCreateInfoKHR info{};info.imageExtent={1280,720};info.imageFormat=VK_FORMAT_R8G8B8A8_UNORM;auto next=handle<VkSwapchainKHR>(6);
  MenuOverlayVk::CreateSwapchain(handle<VkDevice>(1),handle<VkPhysicalDevice>(2),handle<VkInstance>(3),(HWND)1,&info,nullptr,&next);
  MenuOverlayVk::ShutdownSwapchain(handle<VkDevice>(1),handle<VkSwapchainKHR>(5));
  require(count("Framebuffer")==0&&_vkCreationPending&&!_vkClosingRequested,"old swapchain shutdown blocked previously admitted replacement");
  uint32_t index=0;VkPresentInfoKHR present{VK_STRUCTURE_TYPE_PRESENT_INFO_KHR,nullptr,0,nullptr,1,&next,&index};
  require(draw(handle<VkQueue>(4),&present)==MenuOverlayVk::QueuePresentStatus::Accepted,"replacement did not initialize after old swapchain destruction");
  MenuOverlayVk::ShutdownSwapchain(handle<VkDevice>(1),next);require(count("Framebuffer")==0&&count("Semaphore")==1,"matching shutdown leaked render objects or lost pending WSI wait");
  MenuOverlayVk::NotifyDeviceDestroyed(handle<VkDevice>(1));
 }
 std::cout<<"PASS "<<mode<<"\n";return 0;
 }catch(const std::exception& e){std::cerr<<"FAIL "<<e.what()<<"\n";return 1;}}
