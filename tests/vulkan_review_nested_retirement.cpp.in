 Check(!g_nativeVk.controlLock&&!g_vkCleanupActive,"actual shutdown route loop restores control-lock and cleanup ownership");
 Check(realDestroyCalls==1,"actual destroy hook forwards the genuine target exactly once");
 Check(!old->Current(0)&&!late->Current(0)&&!nativeFeatures.Current(41).generation,"old device generations are revoked across the real destruction boundary");
 Check(fresh&&fresh->Current(0)&&nativeFeatures.Current(42).generation==fresh->frame.evaluation.featureGeneration,"registration after real destruction at reused address remains current");
 Check(g_nativeRawVk.observation&&g_nativeRawVk.observation->frame.evaluation.invocation==4,"delayed old-device cleanup preserves replacement raw diagnostics");
 Check(g_nativeVk.nativeStatus.observation&&g_nativeVk.nativeStatus.latestInvocation==4,"delayed old-device cleanup preserves replacement selected diagnostics without a model owner");
 ObserveNativeResultVk(*late,cfg,{},false,false,false,true);
 Check(g_nativeRawVk.observation&&g_nativeRawVk.observation->frame.evaluation.invocation==4&&g_nativeVk.nativeStatus.latestInvocation==4,"late old-source terminal cannot overwrite the genuine replacement");
 Check(other->Current(0)&&nativeFeatures.Current(53).generation,"another device is unaffected by either source lifetime");
 nrDestroyDevice(a,nullptr);
 Check(realDestroyCalls==2&&!fresh->Current(0)&&!g_nativeRawVk.observation&&!g_nativeVk.nativeStatus.observation,"later actual destruction retires replacement exactly once and clears its own diagnostics");
 nativeFeatures.Register(44,1,reinterpret_cast<uintptr_t>(a));auto matching=Observe(44,6);ObserveNativeResultVk(*matching,cfg,{},false,false,false,true);g_nativeVk.device=a;
 DeviceDestroyedVk(a,VulkanNativeFeatures::BeginDeviceRetirement(reinterpret_cast<uintptr_t>(a)));
 Check(!g_nativeVk.nativeStatus.observation&&!g_nativeRawVk.observation&&resourceCleanupCalls==2,"matching old-generation selected and raw diagnostics clear while retained-root cleanup continues");
 nativeFeatures.Register(45,1,reinterpret_cast<uintptr_t>(a));auto otherFresh=Observe(53,7);ObserveNativeResultVk(*otherFresh,cfg,{},false,false,false,true);g_nativeVk.device=a;
 DeviceDestroyedVk(a,VulkanNativeFeatures::BeginDeviceRetirement(reinterpret_cast<uintptr_t>(a)));
 Check(g_nativeVk.nativeStatus.observation&&g_nativeVk.nativeStatus.observation->device==b&&otherFresh->Current(0)&&resourceCleanupCalls==3,"other-device selected diagnostics survive old-root cleanup even below its generation cutoff");
 g_nativeVk.device=a;{std::unique_lock lock(g_vkMutex);ShutdownVkSessionsLocked(false,a,lock);}
 Check(!g_nativeVk.nativeStatus.observation&&resourceCleanupCalls==4&&otherFresh->Current(0),"general shutdown with default no-cutoff still clears selected diagnostics and continues cleanup");
 std::printf("RESULT checks=%u failed=%u CPU_ONLY=true NO_DEVICE=true\n",checks,failed);return failed?1:0;
