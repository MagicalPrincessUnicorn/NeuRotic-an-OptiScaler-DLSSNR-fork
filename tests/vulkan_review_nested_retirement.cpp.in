 TestConfig config;config.SetDlssNrEnabled(true);config.DlssNrRoute=0u;const NrConfigSnapshot<TestConfig> cfg(config);
 nativeFeatures.Register(41,1,reinterpret_cast<uintptr_t>(a));nativeFeatures.Register(42,1,reinterpret_cast<uintptr_t>(a));nativeFeatures.Register(53,1,reinterpret_cast<uintptr_t>(b));
 auto old=Observe(42,1),late=Observe(42,2),other=Observe(53,3);ObserveNativeResultVk(*old,cfg,{},false,false,false,true);
