    {
      "id": "ingame.menu-common.upscales_the_image_internally_to_a_higher_output_1bbfcfb2",
      "translation": "Skaluje obraz wewnętrznie do wyższej rozdzielczości wyjściowej",
      "revision": 0,
      "note": "Draft translation; semantic and native-speaker review pending."
    },
    {
      "id": "ingame.menu-common.upscales_the_image_internally_to_a_higher_output_85208d7c",
      "translation": "Skaluje obraz wewnętrznie do wyższej rozdzielczości wyjściowej,\na następnie skaluje go w dół z powrotem do rozdzielczości ekranu\n\nWartości <1.0 sprawiają, że moduł skalujący jest mniej wymagający\nWartości >1.0 wyostrzają obraz kosztem wydajności\n\nJeśli jest wyszarzone, sprawdź Git Wiki - poprawki Unreal Engine\n\nDocelowa rozdzielczość i całkowity współczynnik na dole (maks. łącznie 3.0!)",
      "revision": 0,
      "note": "Draft translation; semantic and native-speaker review pending."
    },
