    },
    {
      "id": "ingame.dlssnr-menu.what_it_cannot_show_dlss_fsr_xess_upscaler_prese_89ade1fe",
      "translation": "它无法显示的内容：DLSS/FSR/XeSS 放大器预设或任何上游内容",
      "revision": 0,
