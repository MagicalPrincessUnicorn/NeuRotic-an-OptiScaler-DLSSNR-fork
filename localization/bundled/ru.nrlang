    },
    {
      "id": "ingame.experimentalmfgcontrols.experimental_mfg_unlock_for_rtx_d_series_039f158c",
      "translation": "Экспериментальная разблокировка MFG для серии RTX %d",
      "revision": 0,
      "note": "Draft translation; semantic and native-speaker review pending."
