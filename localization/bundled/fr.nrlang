    {
      "id": "ingame.menu-common.enable_optiscaler_s_sharpening_filter_3bf607a0",
      "translation": "Activer le filtre de netteté d'OptiScaler",
      "revision": 0,
      "note": "Draft translation; semantic and native-speaker review pending."
    },
    {
      "id": "ingame.menu-common.enable_optiscaler_s_sharpening_filter_by_default_b59f8bf7",
      "translation": "Activer le filtre de netteté d'OptiScaler\nUtilise par défaut une valeur de netteté fournie par le jeu\nSélectionnez 'Forcer' sous 'Netteté' et ajustez le curseur\npour la modifier\n\nCertains upscalers ont leur propre filtre de netteté, donc cette\noption n'est pas toujours nécessaire",
      "revision": 0,
      "note": "Draft translation; semantic and native-speaker review pending."
