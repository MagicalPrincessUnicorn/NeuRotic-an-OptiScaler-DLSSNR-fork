      "control": "status",
      "english": "Frame ms avg %.2f | median %.2f | p95 %.2f | max %.2f",
      "id": "ingame.dlssnr-menu.frame_ms_avg_2f_median_2f_p95_2f_max_2f_e4c9efbc",
