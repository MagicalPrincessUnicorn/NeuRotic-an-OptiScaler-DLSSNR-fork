      ],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Рассмотрите возможность переименования OptiScaler из %s в другое поддерживаемое имя.\nВ противном случае у вас могут возникнуть проблемы."
    },
