    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "label",
      "english": "even-handed about left and right, and a difference can read as an",
      "id": "ingame.dlssnr-menu.even_handed_about_left_and_right_and_a_differenc_11019a25",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
