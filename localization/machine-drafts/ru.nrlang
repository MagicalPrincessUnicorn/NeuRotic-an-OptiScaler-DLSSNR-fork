      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "status",
      "english": "Bridge handoffs %llu | model builds %llu | evaluations %llu | compositions %llu | copy-backs %llu",
      "id": "ingame.dlssnr-menu.bridge_handoffs_llu_model_builds_llu_evaluations_9c236dca",
