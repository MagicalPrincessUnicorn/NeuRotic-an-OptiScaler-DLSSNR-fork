      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Завершите или отмените анализ, прежде чем делать сравнения."
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "label",
      "english": "flat near-white picture, its answer is scaled away, and only its hue",
      "id": "ingame.dlssnr-menu.flat_near_white_picture_its_answer_is_scaled_awa_f12f994e",
      "line_breaks": false,
