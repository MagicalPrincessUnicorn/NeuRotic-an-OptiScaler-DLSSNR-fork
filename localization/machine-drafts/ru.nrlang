      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "HDR Present использует фиксированную точку белого 2.5; настройки экспозиции Native остаются неактивными."
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "warning",
      "english": "(held: absent this frame)",
