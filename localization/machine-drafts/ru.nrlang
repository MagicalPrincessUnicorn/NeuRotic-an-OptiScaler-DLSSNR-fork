      "revision": 1,
      "sources": [
        {
          "path": "tools/packaging/customer/support/NeuRotic-InstallDefaults.ps1",
          "line": 46,
          "kind": "typed-message-producer"
        }
      ],
      "translation": "Не удалось прочитать настройки установки по умолчанию. Использованы настройки пакета по умолчанию; файл настроек сохранен.",
      "note": "Machine draft; semantic and native-speaker review pending."
    }
  ],
  "in_game": [
    {
      "context": "Current UI presentation binding",
      "control": "paragraph",
      "english": "NR Anything processes the captured game window, including its HUD. It uses one image pass.",
      "id": "ingame.anything_mode.description",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [
        "NR Anything"
      ],
      "revision": 1,
      "section": "anything_mode",
      "surface": "in_game",
      "translation": "NR Anything обрабатывает захваченное окно игры, включая ее HUD. Используется один проход изображения."
    },
    {
      "context": "Current UI: OptiScaler/nr/semantic/character/CharacterInspectorMenu.h",
      "control": "paragraph",
