      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Автоматическая маска кожи"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "label",
      "english": "Automatic",
      "id": "ingame.dlssnr-menu.automatic_33f5300c",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Автоматически"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "paragraph",
      "english": "Automatic uses an observed clear. Manual depth direction applies immediately; an incorrect convention can distort rendering.",
      "id": "ingame.dlssnr-menu.automatic_uses_an_observed_clear_manual_depth_di_3c6c3442",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Автоматический режим использует наблюдаемую очистку. Ручное направление глубины применяется немедленно; неверное соглашение может исказить рендеринг."
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "label",
      "english": "Backbuffer format",
      "id": "ingame.dlssnr-menu.backbuffer_format_7ecea65f",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Формат заднего буфера"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "status",
      "english": "Basic Multipass totals are zero. Image unchanged; loaded resources retained.",
