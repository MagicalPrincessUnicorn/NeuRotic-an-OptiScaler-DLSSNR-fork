    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "tooltip",
      "english": "Selects this pass's model processing profile. Default is strongest; Natural and Cinematic are progressively gentler alternatives.",
