    {
      "context": "Current UI: tools/packaging/customer/support/NeuRotic-HubSettings.ps1",
      "control": "paragraph",
      "english": "For Manual percent/Automatic: 25-200 percent. For legacy modes: 0=100%, 1=77%, 2=67%, 3=58%, 4=50%, 5=33%.",
      "id": "desktop.neurotic-hubsettings.for_manual_percent_automatic_25_200_percent_for__4dca5387",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "neurotic-hubsettings",
      "surface": "desktop",
      "translation": "Для ручного процента/Автоматически: 25-200 процентов. Для устаревших режимов: 0=100%, 1=77%, 2=67%, 3=58%, 4=50%, 5=33%."
