    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "paragraph",
      "english": "Some backends require this pass for nonzero sharpening even when the optional toggle is off.",
      "id": "ingame.menu-common.some_backends_require_this_pass_for_nonzero_shar_0f24978d",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Некоторым бэкендам требуется этот проход для ненулевой резкости, даже если дополнительный переключатель выключен."
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "label",
      "english": "Some of those pixels might even be real!",
