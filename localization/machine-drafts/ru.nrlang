    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "paragraph",
      "english": "Defines the motion range over which the effect ramps from zero to full strength.",
      "id": "ingame.menu-common.defines_the_motion_range_over_which_the_effect_r_171a7e4c",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Определяет диапазон движения, в котором эффект усиливается от нуля до полной силы."
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "paragraph",
      "english": "Defines the motion range over which the effect ramps from zero to full strength.\n\nValues above the threshold are mapped into this range.\nLarger values make the response smoother and more gradual.\nSmaller values make the effect react more quickly and aggressively.",
      "id": "ingame.menu-common.defines_the_motion_range_over_which_the_effect_r_3f160eee",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Определяет диапазон движения, в котором эффект усиливается от нуля до полной силы.\n\nЗначения выше порога отображаются в этом диапазоне.\nБольшие значения делают реакцию более плавной и постепенной.\nМеньшие значения заставляют эффект реагировать быстрее и агрессивнее."
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "label",
      "english": "Delay HUDless capture, high values might cause crash!",
      "id": "ingame.menu-common.delay_hudless_capture_high_values_might_cause_cr_9758910b",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Задержка захвата без HUD, высокие значения могут привести к сбою!"
    },
