    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "status",
      "english": "Present runs on the final image and chooses qualified guides or image-only input per frame.",
      "id": "ingame.dlssnr-menu.present_runs_on_the_final_image_and_chooses_qual_6a2945cb",
      "line_breaks": false,
