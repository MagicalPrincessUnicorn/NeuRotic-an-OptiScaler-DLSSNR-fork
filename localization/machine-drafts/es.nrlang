      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Retrasar captura sin HUD, ¡los valores altos pueden causar un fallo!"
    },
