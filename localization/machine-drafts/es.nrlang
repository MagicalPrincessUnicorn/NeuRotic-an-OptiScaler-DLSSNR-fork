      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Present se ejecuta en la imagen final y elige guías calificadas o entrada de solo imagen por fotograma."
    },
    {
