    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "label",
      "english": "Anchor then bakes into a new point.",
      "id": "ingame.dlssnr-menu.anchor_then_bakes_into_a_new_point_baeff0a2",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Anclar luego se consolida en un nuevo punto."
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "label",
      "english": "and below. At 2 the half is filled and the sides are cropped away",
      "id": "ingame.dlssnr-menu.and_below_at_2_the_half_is_filled_and_the_sides__ad9ab55e",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "y debajo. En 2 la mitad se rellena y los lados se recortan"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "paragraph",
      "english": "and the composition cannot tell them apart -- it reads the blur as brightness",
      "id": "ingame.dlssnr-menu.and_the_composition_cannot_tell_them_apart_it_re_a2e27618",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "y la composición no puede distinguirlos -- lee el desenfoque como brillo"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "label",
      "english": "and the numbers are the same for everyone who takes the profile.",
      "id": "ingame.dlssnr-menu.and_the_numbers_are_the_same_for_everyone_who_ta_8c3120ef",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "y los números son los mismos para todos los que toman el perfil."
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "paragraph",
      "english": "answer does the most damage; 2x leaves detail intact while stopping a strip",
      "id": "ingame.dlssnr-menu.answer_does_the_most_damage_2x_leaves_detail_int_3b99ac29",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "respuesta hace el mayor daño; 2x deja intacto el detalle mientras detiene una tira"
    },
