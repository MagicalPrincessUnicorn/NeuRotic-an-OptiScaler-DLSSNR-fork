    {
      "context": "Current UI: tools/packaging/customer/support/NeuRotic-HubSettings.ps1",
      "control": "paragraph",
      "english": "Saved preset request. The installed DLSS or Ray Reconstruction DLL determines supported presets; Automatic retains existing default/global inheritance.",
      "id": "desktop.neurotic-hubsettings.saved_preset_request_the_installed_dlss_or_ray_r_f32e4653",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [
        "DLSS"
      ],
      "revision": 1,
      "section": "neurotic-hubsettings",
      "surface": "desktop",
      "translation": "Solicitud de preajuste guardada. La DLL de DLSS o Ray Reconstruction instalada determina los preajustes compatibles; Automático mantiene la herencia global/predeterminada existente."
    },
    {
      "context": "Current UI: tools/packaging/customer/support/NeuRotic-HubSettings.ps1",
      "control": "paragraph",
      "english": "Saved request only. Zero disables the override. Ratios depend on the running game, graphics card and provider qualification.",
      "id": "desktop.neurotic-hubsettings.saved_request_only_zero_disables_the_override_ra_a66f0429",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "neurotic-hubsettings",
      "surface": "desktop",
      "translation": "Solo solicitud guardada. Cero desactiva la anulación. Las proporciones dependen del juego en ejecución, la tarjeta gráfica y la cualificación del proveedor."
    },
    {
      "context": "Current UI: tools/packaging/customer/support/NeuRotic-HubSettings.ps1",
      "control": "paragraph",
      "english": "Saved resource-state override. Runtime support depends on the active non-DLSS upscaler and graphics API.",
      "id": "desktop.neurotic-hubsettings.saved_resource_state_override_runtime_support_de_2d44221b",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [
        "DLSS"
      ],
      "revision": 1,
      "section": "neurotic-hubsettings",
      "surface": "desktop",
      "translation": "Anulación de estado de recursos guardada. La compatibilidad en tiempo de ejecución depende del escalador no DLSS activo y de la API de gráficos."
    },
    {
      "context": "Current UI: tools/packaging/customer/support/NeuRotic-HubSettings.ps1",
      "control": "paragraph",
      "english": "Saves the in-game XeFG precheck bypass request. Do not use this to skip a motion-vector size warning for Unreal Engine games. Runtime compatibility is not established by this preference.",
      "id": "desktop.neurotic-hubsettings.saves_the_in_game_xefg_precheck_bypass_request_d_fdc00aff",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "neurotic-hubsettings",
      "surface": "desktop",
      "translation": "Guarda la solicitud para omitir la comprobación previa de XeFG en el juego. No uses esto para omitir una advertencia de tamaño de vector de movimiento para juegos de Unreal Engine. Esta preferencia no establece la compatibilidad en tiempo de ejecución."
    },
