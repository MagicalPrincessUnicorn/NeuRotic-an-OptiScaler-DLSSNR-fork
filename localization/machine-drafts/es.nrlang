    {
      "context": "Current UI: apps/NeuRoticHub/ui/HubShell.cpp",
      "control": "paragraph",
      "english": "Clears saved game inspection and profile data. The library, hidden games and settings inside each game's folder stay unchanged. Fresh details will be read the next time you select a game. No restart is needed.",
      "id": "desktop.hubshell.clears_saved_game_inspection_and_profile_data_th_b9afdcd0",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "hubshell",
      "surface": "desktop",
      "translation": "Borra los datos de inspección y perfiles del juego guardados. La biblioteca, los juegos ocultos y la configuración de la carpeta de cada juego permanecen sin cambios. Se leerán detalles nuevos la próxima vez que selecciones un juego. No es necesario reiniciar."
    },
    {
      "context": "Current UI: apps/NeuRoticHub/ui/HubShell.cpp",
      "control": "paragraph",
      "english": "Clears the local library (including hidden games), preferences, game profiles, artwork, operation receipts and imported Runtime files such as NR models and Streamline. NeuRotic will restart. Installed game files are untouched.",
      "id": "desktop.hubshell.clears_the_local_library_including_hidden_games__516f3998",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [
        "NeuRotic"
      ],
      "revision": 1,
      "section": "hubshell",
      "surface": "desktop",
      "translation": "Borra la biblioteca local (incluidos los juegos ocultos), las preferencias, los perfiles de juego, las ilustraciones, los recibos de operaciones y los archivos del entorno de ejecución importados, como los modelos NR y Streamline. NeuRotic se reiniciará. Los archivos de juegos instalados permanecen intactos."
    },
