    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "paragraph",
      "english": "Hold, Compare and Debug view are unavailable on this Present route; saved settings are retained for Native.",
      "id": "ingame.dlssnr-menu.hold_compare_and_debug_view_are_unavailable_on_t_70770fa8",
