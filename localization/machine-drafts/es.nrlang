      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "La mejor de las rutas probadas:"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "label",
      "english": "between the two is right, not just near one anchor. Up to eight.",
      "id": "ingame.dlssnr-menu.between_the_two_is_right_not_just_near_one_ancho_490eff58",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "entre los dos es correcto, no solo cerca de un anclaje. Hasta ocho."
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "paragraph",
      "english": "both directions -- a pixel may not be brightened past this nor darkened past",
      "id": "ingame.dlssnr-menu.both_directions_a_pixel_may_not_be_brightened_pa_21faa8ab",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "ambas direcciones -- un píxel no se puede iluminar más allá de esto ni oscurecer más allá"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "status",
      "english": "Bridge counters: unavailable",
      "id": "ingame.dlssnr-menu.bridge_counters_unavailable_8686211c",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Contadores del puente: no disponibles"
    },
