    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "paragraph",
      "english": "Controls apply to the active replacement backend. Provider activity does not establish displayed frame delivery.",
      "id": "ingame.menu-common.controls_apply_to_the_active_replacement_backend_e7fdb9ac",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Los controles se aplican al backend de reemplazo activo. La actividad del proveedor no establece la entrega de los fotogramas mostrados."
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "paragraph",
      "english": "Controls how strongly sharpening is reduced across depth edges.\n\nHigher values more aggressively prevent sharpening across object boundaries (reduces halos).\nLower values allow more sharpening to pass across edges (sharper but riskier).",
      "id": "ingame.menu-common.controls_how_strongly_sharpening_is_reduced_acro_49743ae3",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Controla la intensidad con la que se reduce la nitidez a través de los bordes de profundidad.\n\nLos valores más altos evitan más agresivamente la nitidez a través de los límites del objeto (reduce los halos).\nLos valores más bajos permiten que pase más nitidez a través de los bordes (más nítido pero más arriesgado)."
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "label",
      "english": "Controls how strongly sharpening is reduced across depth edges.",
      "id": "ingame.menu-common.controls_how_strongly_sharpening_is_reduced_acro_965fed7b",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Controla la intensidad con la que se reduce la nitidez a través de los bordes de profundidad."
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "label",
      "english": "Controls sharpness at high contrast areas.",
      "id": "ingame.menu-common.controls_sharpness_at_high_contrast_areas_a23b00e2",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Controla la nitidez en áreas de alto contraste."
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "label",
      "english": "Cope smarter, not harder",
      "id": "ingame.menu-common.cope_smarter_not_harder_ab9f08e7",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Lidia con más inteligencia, no con más esfuerzo"
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "label",
      "english": "Coping is strong with this one...",
      "id": "ingame.menu-common.coping_is_strong_with_this_one_8c12616d",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "El nivel de negación es fuerte en este..."
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "label",
      "english": "Corresponds to amount of accumulation added per frame",
      "id": "ingame.menu-common.corresponds_to_amount_of_accumulation_added_per__48f6baf5",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Corresponde a la cantidad de acumulación añadida por fotograma"
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "paragraph",
      "english": "Corresponds to amount of accumulation added per frame\nat pixel coordinate where disocclusion occured or when\nreactive mask value is > 0.0f. Decreasing this and \ndrawing the ghosting object (IE no mv) to reactive mask \nwith value close to 1.0f can decrease temporal ghosting.\nDecreasing this could result in more thin feature pixels flickering.",
      "id": "ingame.menu-common.corresponds_to_amount_of_accumulation_added_per__a71e0ab2",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Corresponde a la cantidad de acumulación añadida por fotograma\nen la coordenada de píxel donde ocurrió la desoclusión o cuando\nel valor de la máscara reactiva es > 0.0f. Disminuir esto y \ndibujar el objeto con ghosting (es decir, sin mv) en la máscara reactiva \ncon un valor cercano a 1.0f puede disminuir el ghosting temporal.\nDisminuir esto podría resultar en un mayor parpadeo de píxeles finos."
    },
