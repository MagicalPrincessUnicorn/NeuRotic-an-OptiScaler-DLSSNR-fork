      "surface": "desktop",
      "translation": "La respuesta del instalador es demasiado grande para mostrarse. Actualiza NeuRotic y actualiza este juego; el resultado completo permanece en la carpeta de diagnósticos."
    },
    {
      "context": "Current UI: apps/NeuRoticHub/install/OperationController.cpp",
      "control": "paragraph",
      "english": "The operation result could not be read. Refresh the game and check Diagnostics.",
      "id": "desktop.operationcontroller.the_operation_result_could_not_be_read_refresh_t_9bde8a5f",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "operationcontroller",
      "surface": "desktop",
      "translation": "El resultado de la operación no se pudo leer. Actualiza el juego y comprueba Diagnósticos."
    },
    {
      "context": "Current UI: apps/NeuRoticHub/install/OperationController.cpp",
      "control": "paragraph",
      "english": "The read-only check stopped reporting progress. No game changes were made; retry or inspect Diagnostics.",
