    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "paragraph",
      "english": "Defines the motion range over which the effect ramps from zero to full strength.",
      "id": "ingame.menu-common.defines_the_motion_range_over_which_the_effect_r_171a7e4c",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Define el rango de movimiento sobre el cual el efecto aumenta de cero a su máxima fuerza."
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "paragraph",
      "english": "Defines the motion range over which the effect ramps from zero to full strength.\n\nValues above the threshold are mapped into this range.\nLarger values make the response smoother and more gradual.\nSmaller values make the effect react more quickly and aggressively.",
      "id": "ingame.menu-common.defines_the_motion_range_over_which_the_effect_r_3f160eee",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Define el rango de movimiento sobre el cual el efecto aumenta de cero a su máxima fuerza.\n\nLos valores por encima del umbral se asignan a este rango.\nLos valores mayores hacen que la respuesta sea más suave y gradual.\nLos valores menores hacen que el efecto reaccione más rápida y agresivamente."
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "label",
