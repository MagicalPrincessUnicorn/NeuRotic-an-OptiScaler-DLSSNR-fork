      "context": "Package defaults used after unreadable saved install defaults; file preserved. App completion and attention dialog.",
      "english": "Install defaults could not be read. Package defaults were used; the preference file was preserved.",
      "placeholders": [],
      "preserve": [],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "tools/packaging/customer/support/NeuRotic-InstallDefaults.ps1",
          "line": 46,
          "kind": "typed-message-producer"
        }
      ],
      "translation": "No se pudieron leer los valores predeterminados de instalación. Se utilizaron los valores predeterminados del paquete; el archivo de preferencias se conservó.",
      "note": "Machine draft; semantic and native-speaker review pending."
    }
