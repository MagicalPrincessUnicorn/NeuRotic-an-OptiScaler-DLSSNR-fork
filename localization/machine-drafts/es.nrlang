    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_StageControls.h",
      "control": "status",
      "english": "This legacy placement is preserved. Ray Reconstruction and native Vulkan use NR after reconstruction; choose Full output or Manual to update it.",
