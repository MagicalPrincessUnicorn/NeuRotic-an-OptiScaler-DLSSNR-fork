    {
      "context": "Current UI: tools/packaging/customer/support/NeuRotic-HubSettings.ps1",
      "control": "paragraph",
      "english": "Restores graphics state after injected rendering work. Automatic retains the existing default; select a manual value only for a known game compatibility requirement.",
      "id": "desktop.neurotic-hubsettings.restores_graphics_state_after_injected_rendering_6937c25c",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "neurotic-hubsettings",
      "surface": "desktop",
      "translation": "Restaura el estado de los gráficos después de un trabajo de renderizado inyectado. Automático mantiene el valor predeterminado existente; selecciona un valor manual solo para un requisito de compatibilidad conocido del juego."
    },
    {
      "context": "Current UI: tools/packaging/customer/support/NeuRotic-HubSettings.ps1",
      "control": "paragraph",
      "english": "Restricts NGX interception to original NVIDIA library names. Change only for a known loader conflict; Automatic retains the existing default.",
      "id": "desktop.neurotic-hubsettings.restricts_ngx_interception_to_original_nvidia_li_f03287e8",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "neurotic-hubsettings",
      "surface": "desktop",
      "translation": "Restringe la intercepción de NGX a los nombres de biblioteca originales de NVIDIA. Cámbiarlo solo por un conflicto conocido con el cargador; Automático mantiene el valor predeterminado existente."
    },
    {
      "context": "Current UI: tools/packaging/customer/support/NeuRotic-HubSettings.ps1",
      "control": "label",
      "english": "Reuse one log file",
      "id": "desktop.neurotic-hubsettings.reuse_one_log_file_1f88d3d3",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "neurotic-hubsettings",
      "surface": "desktop",
      "translation": "Reutilizar un archivo de registro"
    },
    {
      "context": "Current UI: tools/packaging/customer/support/NeuRotic-HubSettings.ps1",
      "control": "paragraph",
      "english": "Route dependent: non-linear depth uses 0.0001–0.003; linear depth uses 0.005–0.03. The running upscaler determines the depth format. Values in the gap are refused.",
      "id": "desktop.neurotic-hubsettings.route_dependent_non_linear_depth_uses_0_0001_0_0_bdcc6a62",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "neurotic-hubsettings",
      "surface": "desktop",
      "translation": "Depende de la ruta: la profundidad no lineal usa 0.0001–0.003; la profundidad lineal usa 0.005–0.03. El escalador en ejecución determina el formato de profundidad. Se rechazan los valores en el intervalo intermedio."
    },
    {
      "context": "Current UI: tools/packaging/customer/support/NeuRotic-HubSettings.ps1",
      "control": "paragraph",
      "english": "Route dependent: non-linear depth uses 25–400; linear depth uses 100–600. This editor exposes the union without claiming the active depth format.",
      "id": "desktop.neurotic-hubsettings.route_dependent_non_linear_depth_uses_25_400_lin_84a64a4b",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "neurotic-hubsettings",
      "surface": "desktop",
      "translation": "Depende de la ruta: la profundidad no lineal usa 25–400; la profundidad lineal usa 100–600. Este editor muestra la unión sin reclamar el formato de profundidad activo."
    },
    {
      "context": "Current UI: tools/packaging/customer/support/NeuRotic-HubSettings.ps1",
      "control": "paragraph",
      "english": "s native DLSS Frame Generation with FG Input and Output set to None and replacement FG disabled in the in-game menu. Enable FG in the game",
      "id": "desktop.neurotic-hubsettings.s_native_dlss_frame_generation_with_fg_input_and_b8a2ffa8",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [
        "DLSS"
      ],
      "revision": 1,
      "section": "neurotic-hubsettings",
      "surface": "desktop",
      "translation": "s Generación de fotogramas DLSS nativa con la entrada y salida de FG configuradas en Ninguno y la FG de reemplazo desactivada en el menú del juego. Activa FG en el juego",
      "note": "Prefix 's ' is presumed to be part of a cut-off possessive like 'game\\'s', preserved literally as requested."
    },
