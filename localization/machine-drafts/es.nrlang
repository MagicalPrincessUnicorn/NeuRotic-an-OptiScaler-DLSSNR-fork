      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "operationcontroller",
      "surface": "desktop",
      "translation": "La comprobación de solo lectura dejó de informar del progreso. No se realizaron cambios en el juego; vuelve a intentarlo o inspecciona Diagnósticos."
    },
