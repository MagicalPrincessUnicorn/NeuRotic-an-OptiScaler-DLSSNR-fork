    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "paragraph",
      "english": "Sets detail blending for Pass 2 through the selected final pass. Release to apply without rebuilding models. 100% is default; 0% hides the detail edit. Pass 1 and colour strength are unchanged.",
      "id": "ingame.dlssnr-menu.sets_detail_blending_for_pass_2_through_the_sele_d933815a",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Establece la mezcla de detalles para el Pase 2 hasta el pase final seleccionado. Suelte para aplicar sin reconstruir los modelos. 100% es el valor predeterminado; 0% oculta la edición de detalles. El Pase 1 y la intensidad del color permanecen sin cambios."
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "paragraph",
      "english": "Sets internal model intensity for Pass 2 through the selected final pass. Release to apply and rebuild only changed child models. 100% is default; 0% does not disable model execution. Pass 1 is unchanged.",
      "id": "ingame.dlssnr-menu.sets_internal_model_intensity_for_pass_2_through_a7906573",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Establece la intensidad del modelo interno para el Pase 2 hasta el pase final seleccionado. Suelte para aplicar y reconstruir solo los modelos secundarios modificados. 100% es el valor predeterminado; 0% no desactiva la ejecución del modelo. El Pase 1 permanece sin cambios."
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "paragraph",
      "english": "Sets one model-raster percentage for Pass 1 and every active additional pass",
