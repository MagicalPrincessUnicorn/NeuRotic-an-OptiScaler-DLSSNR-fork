    {
      "context": "Installation preparation is static; save error reports actual writer outcome.",
      "control": "status",
      "english": "Your changes remain available. Resolve the file error, then save again.",
      "id": "ingame.persistence_failure.changes_retained",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "persistence",
