    {
      "id": "ingame.dlssnr-menu.writes_which_side_is_which_onto_the_frame_itself_0115a956",
      "surface": "in_game",
      "section": "dlssnr-menu",
      "control": "tooltip",
      "english": "Writes which side is which onto the frame itself, so a screenshot still\nsays so after it has left this machine. Drawn into the picture's own\nplane: in the wipe the split reveals and hides the label exactly as it\ndoes the images, and there is nothing to drag. Swap sides moves the\nlabels with their pictures.",
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "placeholders": [],
      "preserve": [],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "OptiScaler/dlssnr/DlssNr_Menu.cpp",
          "line": 2836,
          "kind": "presentation-binding"
        }
      ],
      "translation": "Zapisuje informację, która strona jest którą, na samej klatce, aby zrzut ekranu nadal\nto wskazywał po opuszczeniu tego komputera. Narysowane na własnej\npłaszczyźnie obrazu: w funkcji odcięcia podział odkrywa i ukrywa etykietę dokładnie tak samo\njak robi to z obrazami, i nie ma nic do przeciągnięcia. Opcja zamiany stron przesuwa\netykiety razem z ich obrazami.",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
