    {
      "id": "ingame.menu-common.maximum_amount_of_sharpness_that_motion_can_add__3ca7eb87",
      "surface": "in_game",
      "section": "menu-common",
      "control": "paragraph",
      "english": "Maximum amount of sharpness that motion can add or remove.\n\nNegative values reduce sharpening in motion (recommended).\nPositive values increase sharpening in motion.\n\nThe final adjustment scales with motion and is capped at this value.",
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "placeholders": [],
      "preserve": [],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "OptiScaler/menu/menu_common.cpp",
          "line": 5643,
          "kind": "presentation-binding"
        }
      ],
      "translation": "Maksymalna ilość ostrości, którą ruch może dodać lub usunąć.\n\nWartości ujemne zmniejszają wyostrzanie w ruchu (zalecane).\nWartości dodatnie zwiększają wyostrzanie w ruchu.\n\nKońcowe dostosowanie skaluje się z ruchem i jest ograniczone do tej wartości.",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
