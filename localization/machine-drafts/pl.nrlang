    {
      "id": "desktop.gamesettingsview.this_saved_profile_is_used_only_when_advanced_mu_b8c1ac32",
      "surface": "desktop",
      "section": "gamesettingsview",
      "control": "paragraph",
      "english": "This saved profile is used only when Advanced Multipass includes this pass. Automatic values inherit the preceding pass when the game loads them.",
