    {
      "id": "ingame.dlssnr-menu.proxy_is_the_picture_handed_to_the_model_if_that_9a0bd5ff",
      "surface": "in_game",
      "section": "dlssnr-menu",
      "control": "paragraph",
      "english": "Proxy is the picture handed to the model -- if that looks wrong, the white point",
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "placeholders": [],
      "preserve": [],
      "line_breaks": false,
      "revision": 1,
      "sources": [
        {
          "path": "OptiScaler/dlssnr/DlssNr_Menu.cpp",
          "line": 3099,
          "kind": "provider"
        }
      ],
      "translation": "Proxy to obraz przekazywany do modelu — jeśli wygląda niewłaściwie, punkt bieli",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
    {
      "id": "ingame.dlssnr-menu.proxy_is_the_picture_handed_to_the_model_if_that_d99911fa",
      "surface": "in_game",
      "section": "dlssnr-menu",
      "control": "tooltip",
      "english": "Proxy is the picture handed to the model -- if that looks wrong, the white point\nis wrong and nothing downstream can be judged.\n\nDifference shows what the model actually changed, amplified twenty times and\ncentred on grey. A flat grey frame there means it is doing nothing.",
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "placeholders": [],
      "preserve": [],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "OptiScaler/dlssnr/DlssNr_Menu.cpp",
          "line": 2893,
          "kind": "presentation-binding"
        }
      ],
      "translation": "Proxy to obraz przekazywany do modelu — jeśli wygląda niewłaściwie, punkt bieli\njest błędny i nie można ocenić niczego, co dzieje się dalej.\n\nRóżnica pokazuje, co model faktycznie zmienił, wzmocnione dwudziestokrotnie i\nwyśrodkowane na szarości. Płaska szara klatka oznacza w tym miejscu, że model nie robi nic.",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
    {
      "id": "ingame.dlssnr-menu.proxy_what_the_model_sees_c4cf3eb8",
      "surface": "in_game",
      "section": "dlssnr-menu",
      "control": "label",
      "english": "Proxy (what the model sees)",
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "placeholders": [],
      "preserve": [],
      "line_breaks": false,
      "revision": 1,
      "sources": [
        {
          "path": "OptiScaler/dlssnr/DlssNr_Menu.cpp",
          "line": 2887,
          "kind": "presentation-binding"
        }
      ],
      "translation": "Proxy (to, co widzi model)",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
    {
      "id": "ingame.dlssnr-menu.purely_a_readout_it_changes_nothing_1dd3196c",
