    {
      "id": "ingame.experimentalmfgcontrols.confirmed_gpu_corruption_safety_checks_remain_ac_a0d2454c",
      "surface": "in_game",
      "section": "experimentalmfgcontrols",
      "control": "paragraph",
      "english": "Confirmed GPU-corruption safety checks remain active. This choice applies only after you agree. Save settings and restart the game; this does not prove provider support or displayed frame delivery. Do not combine external unlockers.",
      "context": "Current UI: OptiScaler/menu/ExperimentalMfgControls.h",
      "placeholders": [],
      "preserve": [],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "OptiScaler/menu/ExperimentalMfgControls.h",
          "line": 41,
          "kind": "presentation-binding"
        }
      ],
      "translation": "Potwierdzone kontrole bezpieczeństwa przed uszkodzeniem GPU pozostają aktywne. Ten wybór ma zastosowanie dopiero po wyrażeniu zgody. Zapisz ustawienia i zrestartuj grę; nie dowodzi to obsługi ze strony dostawcy ani dostarczania wyświetlanych klatek. Nie łącz z zewnętrznymi unlockerami.",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
