      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "folgt dem Scan von dort nach Verhältnis wie zuvor. Gehen Sie in sehr"
    },
