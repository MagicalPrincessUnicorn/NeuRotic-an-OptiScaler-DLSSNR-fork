    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "label",
      "english": "A confirmation is required.",
      "id": "ingame.dlssnr-menu.a_confirmation_is_required_1f6bfcef",
