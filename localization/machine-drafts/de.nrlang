    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "label",
      "english": "Proxy composition",
      "id": "ingame.dlssnr-menu.proxy_composition_cf6178ff",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Proxy-Komposition"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "paragraph",
      "english": "Proxy is the picture handed to the model -- if that looks wrong, the white point",
      "id": "ingame.dlssnr-menu.proxy_is_the_picture_handed_to_the_model_if_that_9a0bd5ff",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Proxy ist das dem Modell übergebene Bild -- wenn das falsch aussieht, ist der Weißpunkt"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "tooltip",
      "english": "Proxy is the picture handed to the model -- if that looks wrong, the white point\nis wrong and nothing downstream can be judged.\n\nDifference shows what the model actually changed, amplified twenty times and\ncentred on grey. A flat grey frame there means it is doing nothing.",
      "id": "ingame.dlssnr-menu.proxy_is_the_picture_handed_to_the_model_if_that_d99911fa",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Proxy ist das dem Modell übergebene Bild -- wenn das falsch aussieht, ist der Weißpunkt\nfalsch und nichts nachgelagertes kann beurteilt werden.\n\nDifferenz zeigt, was das Modell tatsächlich geändert hat, zwanzigfach verstärkt und\nauf Grau zentriert. Ein flaches graues Frame dort bedeutet, dass es nichts tut."
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "label",
      "english": "Proxy (what the model sees)",
      "id": "ingame.dlssnr-menu.proxy_what_the_model_sees_c4cf3eb8",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Proxy (was das Modell sieht)"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "label",
      "english": "Purely a readout. It changes nothing.",
      "id": "ingame.dlssnr-menu.purely_a_readout_it_changes_nothing_1dd3196c",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Nur eine Anzeige. Es ändert nichts."
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "label",
      "english": "Puts the edited frame on the other side.",
      "id": "ingame.dlssnr-menu.puts_the_edited_frame_on_the_other_side_6301db7f",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Legt das bearbeitete Frame auf die andere Seite."
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "tooltip",
      "english": "Puts the edited frame on the other side.\n\nWorth doing once you have decided which you prefer: the eye is not\neven-handed about left and right, and a difference can read as an\nimprovement purely from where it sits. If the same side still wins after\nswapping, it is the pass you are seeing and not the placement.",
      "id": "ingame.dlssnr-menu.puts_the_edited_frame_on_the_other_side_worth_do_14f1fea8",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Legt das bearbeitete Frame auf die andere Seite.\n\nLohnt sich, wenn Sie entschieden haben, was Sie bevorzugen: das Auge ist nicht\nunvoreingenommen gegenüber links und rechts, und ein Unterschied kann allein durch\ndie Platzierung als Verbesserung wahrgenommen werden. Wenn dieselbe Seite nach dem\nTauschen immer noch gewinnt, sehen Sie den Durchlauf und nicht die Platzierung."
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "status",
      "english": "Quality active: Post-SR after native DLSS upscale.",
      "id": "ingame.dlssnr-menu.quality_active_post_sr_after_native_dlss_upscale_08cd00d8",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [
        "DLSS"
      ],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Qualität aktiv: Post-SR nach nativem DLSS-Upscale."
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "status",
      "english": "Quality requested: waiting for a successful Post-SR evaluation.",
      "id": "ingame.dlssnr-menu.quality_requested_waiting_for_a_successful_post__3abcce55",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Qualität angefordert: Warten auf eine erfolgreiche Post-SR-Auswertung."
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "paragraph",
      "english": "Raise it until the picture stops improving. Past that point it does not",
      "id": "ingame.dlssnr-menu.raise_it_until_the_picture_stops_improving_past__afe1cd8c",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Erhöhen Sie es, bis das Bild nicht mehr besser wird. Über diesen Punkt hinaus stagniert es"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "paragraph",
      "english": "rarely anywhere near 1. Measured in Monster Hunter Wilds it takes 16 or more",
      "id": "ingame.dlssnr-menu.rarely_anywhere_near_1_measured_in_monster_hunte_b5d7c17e",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "selten annähernd 1. Gemessen in Monster Hunter Wilds braucht es 16 oder mehr"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
