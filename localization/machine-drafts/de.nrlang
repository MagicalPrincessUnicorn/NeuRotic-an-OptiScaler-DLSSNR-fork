      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Experimentelle Optionen konnten nicht aktiviert werden, da der Crash-Recovery-Marker nicht geschrieben werden konnte."
