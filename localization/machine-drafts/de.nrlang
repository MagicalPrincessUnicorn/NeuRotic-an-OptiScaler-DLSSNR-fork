    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "paragraph",
      "english": "Vulkan reads the qualified SR exposure or owned color meter after actual GPU completion and recording release. Foreign exposure discovery is unavailable without source ownership.",
      "id": "ingame.dlssnr-menu.vulkan_reads_the_qualified_sr_exposure_or_owned__09a4150c",
