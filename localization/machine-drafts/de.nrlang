      "translation": "Bridge-Übergaben %llu | Modell-Builds %llu | Auswertungen %llu | Kompositionen %llu | Copy-Backs %llu"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "paragraph",
      "english": "bright highlights instead of everywhere. Most of Replace's detail, far more",
      "id": "ingame.dlssnr-menu.bright_highlights_instead_of_everywhere_most_of__790014de",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "helle Glanzlichter anstatt überall. Der Großteil von Replaces Detail, viel mehr"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "paragraph",
      "english": "bright lights, but they FLASH in motion. A reference, not a daily setting.",
      "id": "ingame.dlssnr-menu.bright_lights_but_they_flash_in_motion_a_referen_ec63322b",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "helle Lichter, aber sie BLITZEN in Bewegung auf. Eine Referenz, keine Alltagseinstellung."
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "paragraph",
      "english": "bright scenes, but the curve compresses MIDTONES too, so in soft-lit content it",
      "id": "ingame.dlssnr-menu.bright_scenes_but_the_curve_compresses_midtones__14149647",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "helle Szenen, aber die Kurve komprimiert auch MITTELTÖNE, also in weich beleuchteten Inhalten"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "header",
      "english": "Built-in capture",
      "id": "ingame.dlssnr-menu.built_in_capture_8d435da4",
