      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Licht, das sich in eine Kette von farbigen Zellen verwandelt. Erhöhen Sie ihn nur, wenn helle Bereiche"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "tooltip",
      "english": "Limits the brightness multiplication or division this pass may apply. The 2x default protects moving highlights.",
      "id": "ingame.dlssnr-menu.limits_the_brightness_multiplication_or_division_03c66e49",
      "line_breaks": true,
