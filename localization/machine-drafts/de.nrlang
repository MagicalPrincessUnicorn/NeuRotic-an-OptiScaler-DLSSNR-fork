      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Automatische Hautmaske"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "label",
      "english": "Automatic",
      "id": "ingame.dlssnr-menu.automatic_33f5300c",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Automatisch"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "paragraph",
      "english": "Automatic uses an observed clear. Manual depth direction applies immediately; an incorrect convention can distort rendering.",
      "id": "ingame.dlssnr-menu.automatic_uses_an_observed_clear_manual_depth_di_3c6c3442",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Automatisch verwendet einen beobachteten Clear. Die manuelle Tiefenrichtung wird sofort angewendet; eine falsche Konvention kann das Rendering verzerren."
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "label",
      "english": "Backbuffer format",
      "id": "ingame.dlssnr-menu.backbuffer_format_7ecea65f",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Backbuffer-Format"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "status",
      "english": "Basic Multipass totals are zero. Image unchanged; loaded resources retained.",
      "id": "ingame.dlssnr-menu.basic_multipass_totals_are_zero_image_unchanged__b649f5ab",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Basis-Multipass-Summen sind Null. Bild unverändert; geladene Ressourcen beibehalten."
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "paragraph",
      "english": "before the model's detail reaches the frame at all, and the value that suits",
      "id": "ingame.dlssnr-menu.before_the_model_s_detail_reaches_the_frame_at_a_9758ea91",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "bevor das Detail des Modells überhaupt den Frame erreicht, und der Wert, der"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "label",
      "english": "Best of tested routes:",
      "id": "ingame.dlssnr-menu.best_of_tested_routes_a60d8aee",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Beste der getesteten Routen:"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "label",
      "english": "between the two is right, not just near one anchor. Up to eight.",
      "id": "ingame.dlssnr-menu.between_the_two_is_right_not_just_near_one_ancho_490eff58",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "zwischen beiden richtig ist, nicht nur in der Nähe eines Ankers. Bis zu acht."
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "paragraph",
      "english": "both directions -- a pixel may not be brightened past this nor darkened past",
      "id": "ingame.dlssnr-menu.both_directions_a_pixel_may_not_be_brightened_pa_21faa8ab",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "beide Richtungen -- ein Pixel darf weder heller noch dunkler als dies werden"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "status",
      "english": "Bridge counters: unavailable",
      "id": "ingame.dlssnr-menu.bridge_counters_unavailable_8686211c",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
