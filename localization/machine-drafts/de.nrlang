    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "paragraph",
      "english": "An exposure texture is supplied. Native color processing uses it only after a qualified readback completes.",
      "id": "ingame.dlssnr-menu.an_exposure_texture_is_supplied_native_color_pro_6527dfec",
      "line_breaks": true,
