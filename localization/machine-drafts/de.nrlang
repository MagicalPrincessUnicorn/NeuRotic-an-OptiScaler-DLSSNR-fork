    {
      "id": "ingame.menu-common.upscales_the_image_internally_to_a_higher_output_1bbfcfb2",
      "surface": "in_game",
      "section": "menu-common",
      "control": "label",
      "english": "Upscales the image internally to a higher output resolution",
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "placeholders": [],
      "preserve": [],
      "line_breaks": false,
      "revision": 1,
      "sources": [
        {
          "path": "OptiScaler/menu/menu_common.cpp",
          "line": 5807,
          "kind": "provider"
        }
      ],
      "translation": "Skaliert das Bild intern auf eine höhere Ausgabeauflösung hoch",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
    {
      "id": "ingame.menu-common.upscales_the_image_internally_to_a_higher_output_85208d7c",
      "surface": "in_game",
      "section": "menu-common",
      "control": "paragraph",
      "english": "Upscales the image internally to a higher output resolution\nthen downscales it back to your display resolution\n\nValues <1.0 make the upscaler cheaper\nValues >1.0 make image sharper at the cost of performance\n\nIf greyed out, please check Git Wiki - Unreal Engine tweaks\n\nTarget res and total ratio at the bottom (max. total 3.0!)",
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "placeholders": [],
      "preserve": [],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "OptiScaler/menu/menu_common.cpp",
          "line": 5800,
          "kind": "presentation-binding"
        }
      ],
      "translation": "Skaliert das Bild intern auf eine höhere Ausgabeauflösung hoch\nund skaliert es dann wieder auf Ihre Anzeigeauflösung herunter\n\nWerte <1.0 machen den Upscaler ressourcenschonender\nWerte >1.0 machen das Bild schärfer auf Kosten der Leistung\n\nWenn ausgegraut, überprüfen Sie bitte das Git-Wiki - Unreal Engine-Tweaks\n\nZielauflösung und Gesamtverhältnis unten (max. gesamt 3.0!)",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
    {
      "id": "ingame.menu-common.upscaling_for_the_masses_not_the_classes_86fb2d3a",
