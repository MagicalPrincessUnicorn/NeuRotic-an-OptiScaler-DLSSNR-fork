  "in_game": [
    {
      "context": "Current UI presentation binding",
      "control": "paragraph",
      "english": "NR Anything processes the captured game window, including its HUD. It uses one image pass.",
      "id": "ingame.anything_mode.description",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [
        "NR Anything"
      ],
