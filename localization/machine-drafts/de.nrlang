    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "paragraph",
      "english": "Higher values more aggressively prevent sharpening across object boundaries",
      "id": "ingame.menu-common.higher_values_more_aggressively_prevent_sharpeni_de8b7f3b",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Höhere Werte verhindern aggressiver die Schärfung über Objektgrenzen hinweg"
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "paragraph",
      "english": "Higher values reduce flickering and noise from minor depth changes, but may",
      "id": "ingame.menu-common.higher_values_reduce_flickering_and_noise_from_m_9bc707a9",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Höhere Werte reduzieren Flackern und Rauschen bei minimalen Tiefenänderungen, können aber"
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "label",
      "english": "Hope you don't have a good eyesight",
      "id": "ingame.menu-common.hope_you_don_t_have_a_good_eyesight_cb21d14b",
