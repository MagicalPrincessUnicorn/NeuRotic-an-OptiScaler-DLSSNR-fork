    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "paragraph",
      "english": "Sets detail blending for Pass 2 through the selected final pass. Release to apply without rebuilding models. 100% is default; 0% hides the detail edit. Pass 1 and colour strength are unchanged.",
      "id": "ingame.dlssnr-menu.sets_detail_blending_for_pass_2_through_the_sele_d933815a",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Legt die Detailüberblendung für Durchlauf 2 bis zum gewählten finalen Durchlauf fest. Loslassen zum Anwenden ohne Modelle neu aufzubauen. 100% ist Standard; 0% verbirgt die Detailbearbeitung. Durchlauf 1 und Farbstärke bleiben unverändert."
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "paragraph",
      "english": "Sets internal model intensity for Pass 2 through the selected final pass. Release to apply and rebuild only changed child models. 100% is default; 0% does not disable model execution. Pass 1 is unchanged.",
      "id": "ingame.dlssnr-menu.sets_internal_model_intensity_for_pass_2_through_a7906573",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Legt die interne Modellintensität für Durchlauf 2 bis zum gewählten finalen Durchlauf fest. Loslassen zum Anwenden und nur geänderte Kind-Modelle neu aufbauen. 100% ist Standard; 0% deaktiviert die Modellausführung nicht. Durchlauf 1 bleibt unverändert."
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "paragraph",
      "english": "Sets one model-raster percentage for Pass 1 and every active additional pass",
      "id": "ingame.dlssnr-menu.sets_one_model_raster_percentage_for_pass_1_and__2ab6fc82",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Legt einen Modellraster-Prozentsatz für Durchlauf 1 und jeden aktiven zusätzlichen Durchlauf fest"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "paragraph",
      "english": "Sets one model-raster percentage for Pass 1 and every active additional pass in Basic mode. The composed frame remains full resolution. Releasing commits the shared value and rebuilds changed models; disabling Multipass restores the saved main settings.",
      "id": "ingame.dlssnr-menu.sets_one_model_raster_percentage_for_pass_1_and__b644f839",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Legt einen Modellraster-Prozentsatz für Durchlauf 1 und jeden aktiven zusätzlichen Durchlauf im Basismodus fest. Das komponierte Frame bleibt bei voller Auflösung. Loslassen bestätigt den gemeinsamen Wert und baut geänderte Modelle neu auf; die Deaktivierung von Multipass stellt die gespeicherten Haupteinstellungen wieder her."
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "tooltip",
      "english": "Sets skin-structure strength for this pass. Minus one follows Local structure; zero and above tune it independently.",
      "id": "ingame.dlssnr-menu.sets_skin_structure_strength_for_this_pass_minus_8ba2cbd2",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Legt die Hautstrukturstärke für diesen Durchlauf fest. Minus eins folgt lokaler Struktur; null und darüber passen sie unabhängig an."
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "tooltip",
      "english": "Sets the local-structure strength for this pass's independent model session.",
      "id": "ingame.dlssnr-menu.sets_the_local_structure_strength_for_this_pass__65e647ab",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Legt die Stärke der lokalen Struktur für die unabhängige Modellsitzung dieses Durchlaufs fest."
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "tooltip",
      "english": "Sets the local-tone strength for this pass's independent model session.",
      "id": "ingame.dlssnr-menu.sets_the_local_tone_strength_for_this_pass_s_ind_f6d12d1a",
      "line_breaks": false,
      "placeholders": [],
