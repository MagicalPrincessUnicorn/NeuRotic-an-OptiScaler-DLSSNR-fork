    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "paragraph",
      "english": "Defines the motion range over which the effect ramps from zero to full strength.",
      "id": "ingame.menu-common.defines_the_motion_range_over_which_the_effect_r_171a7e4c",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Definiert den Bewegungsbereich, über den der Effekt von Null auf volle Stärke ansteigt."
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "paragraph",
      "english": "Defines the motion range over which the effect ramps from zero to full strength.\n\nValues above the threshold are mapped into this range.\nLarger values make the response smoother and more gradual.\nSmaller values make the effect react more quickly and aggressively.",
      "id": "ingame.menu-common.defines_the_motion_range_over_which_the_effect_r_3f160eee",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Definiert den Bewegungsbereich, über den der Effekt von Null auf volle Stärke ansteigt.\n\nWerte über dem Schwellenwert werden in diesen Bereich abgebildet.\nGrößere Werte machen die Reaktion weicher und allmählicher.\nKleinere Werte lassen den Effekt schneller und aggressiver reagieren."
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
