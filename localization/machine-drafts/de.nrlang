    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "checkbox",
      "english": "Hold frame",
      "id": "ingame.dlssnr-menu.hold_frame_7b9c7233",
      "line_breaks": false,
