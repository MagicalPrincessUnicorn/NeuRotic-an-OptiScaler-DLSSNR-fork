    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_StageControls.h",
      "control": "status",
      "english": "This legacy placement is preserved. Ray Reconstruction and native Vulkan use NR after reconstruction; choose Full output or Manual to update it.",
      "id": "ingame.dlssnr-stagecontrols.this_legacy_placement_is_preserved_ray_reconstru_a9c0abcb",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-stagecontrols",
      "surface": "in_game",
      "translation": "Diese veraltete Platzierung bleibt erhalten. Ray Reconstruction und natives Vulkan verwenden NR nach der Rekonstruktion; wählen Sie Full-Ausgabe oder Manuell, um dies zu aktualisieren."
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_StageControls.h",
      "control": "paragraph",
      "english": "while remaining fast, but moving objects may flicker or ghost when the game does not",
      "id": "ingame.dlssnr-stagecontrols.while_remaining_fast_but_moving_objects_may_flic_a4fadde2",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-stagecontrols",
      "surface": "in_game",
      "translation": "während es schnell bleibt, aber sich bewegende Objekte können flackern oder Geisterbilder erzeugen, wenn das Spiel keine"
    },
    {
      "context": "Current UI: OptiScaler/menu/ExperimentalMfgControls.h",
      "control": "label",
      "english": "Confirm experimental GPU compatibility",
      "id": "ingame.experimentalmfgcontrols.confirm_experimental_gpu_compatibility_673dc4f5",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
