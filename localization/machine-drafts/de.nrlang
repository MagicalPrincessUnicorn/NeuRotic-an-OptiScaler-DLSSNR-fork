    {
      "id": "ingame.menu-common.similar_to_lanczos2_smoother_and_less_prone_to_a_b68bcd9e",
      "surface": "in_game",
      "section": "menu-common",
      "control": "paragraph",
      "english": "Similar to Lanczos2.\nSmoother and less prone to artefacts than Lanczos, but slightly blurrier.",
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "placeholders": [],
      "preserve": [],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "OptiScaler/menu/menu_common.cpp",
          "line": 5826,
          "kind": "presentation-binding"
        }
      ],
      "translation": "Ähnlich wie Lanczos2.\nGlatter und weniger anfällig für Artefakte als Lanczos, aber etwas unschärfer.",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
    {
      "id": "ingame.menu-common.similar_to_lanczos3_far_less_prone_to_artefactin_0d2c10d6",
      "surface": "in_game",
      "section": "menu-common",
      "control": "paragraph",
      "english": "Similar to Lanczos3.\nFar less prone to artefacting than Lanczos3, but much heavier on the GPU.\nConsidered the best along with Lanczos3.",
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "placeholders": [],
      "preserve": [],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "OptiScaler/menu/menu_common.cpp",
          "line": 5828,
          "kind": "presentation-binding"
        }
      ],
      "translation": "Ähnlich wie Lanczos3.\nWeitaus weniger anfällig für Artefaktbildung als Lanczos3, aber viel anspruchsvoller für die GPU.\nGilt neben Lanczos3 als das Beste.",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
