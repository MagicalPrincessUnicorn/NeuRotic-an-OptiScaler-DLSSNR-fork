      "translation": "Erweitert und verbessert"
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "paragraph",
      "english": "Experimental Native D3D12 support for eligible multi-mip depth textures. Leave off unless testing a depth compatibility problem; game benefit remains unverified. Resource, format, synchronization, ownership and completion checks remain active.",
      "id": "ingame.menu-common.experimental_native_d3d12_support_for_eligible_m_96e2152d",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Experimenteller nativer D3D12-Support für geeignete Multi-Mip-Tiefentexturen. Ausgeschaltet lassen, es sei denn, Sie testen ein Tiefenkompatibilitätsproblem; der Nutzen für das Spiel bleibt unbestätigt. Ressourcen-, Format-, Synchronisations-, Eigentums- und Abschlussprüfungen bleiben aktiv."
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "paragraph",
      "english": "Experimental options are inactive because another game process owns the experimental session marker.",
      "id": "ingame.menu-common.experimental_options_are_inactive_because_anothe_023c60b2",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Experimentelle Optionen sind inaktiv, da ein anderer Spielprozess den experimentellen Sitzungsmarker besitzt."
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "paragraph",
      "english": "Experimental options could not be activated because the crash-recovery marker could not be written.",
