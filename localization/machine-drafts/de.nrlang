      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Eine Belichtungstextur wird bereitgestellt. Die native Farbverarbeitung verwendet sie erst, nachdem ein qualifizierter Readback abgeschlossen ist."
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "label",
      "english": "Analysis cancelled; original settings restored.",
