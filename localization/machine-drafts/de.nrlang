    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "paragraph",
      "english": "Ignores small depth differences before edge detection.\n\nHigher values reduce flickering and noise from minor depth changes, but may soften real geometry edges.\nLower values preserve fine detail but can cause unstable or noisy edge detection.",
      "id": "ingame.menu-common.ignores_small_depth_differences_before_edge_dete_07c7366b",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Ignoriert kleine Tiefenunterschiede vor der Kantenerkennung.\n\nHöhere Werte reduzieren Flackern und Rauschen bei minimalen Tiefenänderungen, können aber echte Geometriekanten weicher machen.\nNiedrigere Werte erhalten feine Details, können aber zu instabiler oder verrauschter Kantenerkennung führen."
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "label",
      "english": "Ignores small depth differences before edge detection.",
      "id": "ingame.menu-common.ignores_small_depth_differences_before_edge_dete_249d8bbb",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Ignoriert kleine Tiefenunterschiede vor der Kantenerkennung."
    },
