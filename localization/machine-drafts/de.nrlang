      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "HUDless-Erfassung verzögern, hohe Werte könnten Abstürze verursachen!"
    },
