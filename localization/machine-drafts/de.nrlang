      "translation": "Vom nativen Besitzer aufgezeichnet"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "label",
      "english": "red; step out and it should go green. If it moves the wrong way,",
      "id": "ingame.dlssnr-menu.red_step_out_and_it_should_go_green_if_it_moves__1bed49bf",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "rot; treten Sie heraus und es sollte grün werden. Wenn es sich in die falsche Richtung bewegt,"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "button",
      "english": "Refresh observations",
      "id": "ingame.dlssnr-menu.refresh_observations_57f5c6d4",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Beobachtungen aktualisieren"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "label",
      "english": "relationship and the white point holds between them. Click a row below",
      "id": "ingame.dlssnr-menu.relationship_and_the_white_point_holds_between_t_55a0cc8d",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Beziehung, und der Weißpunkt hält dazwischen. Klicken Sie unten auf eine Zeile"
    },
    {
