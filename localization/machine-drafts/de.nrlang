    {
      "context": "Current UI: apps/NeuRoticHub/ui/HubShell.cpp",
      "control": "paragraph",
      "english": "Clears saved game inspection and profile data. The library, hidden games and settings inside each game's folder stay unchanged. Fresh details will be read the next time you select a game. No restart is needed.",
      "id": "desktop.hubshell.clears_saved_game_inspection_and_profile_data_th_b9afdcd0",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "hubshell",
      "surface": "desktop",
      "translation": "Löscht gespeicherte Spielinspektions- und Profildaten. Die Bibliothek, ausgeblendete Spiele und Einstellungen im Ordner jedes Spiels bleiben unverändert. Beim nächsten Auswählen eines Spiels werden neue Details eingelesen. Ein Neustart ist nicht erforderlich."
    },
    {
      "context": "Current UI: apps/NeuRoticHub/ui/HubShell.cpp",
      "control": "paragraph",
      "english": "Clears the local library (including hidden games), preferences, game profiles, artwork, operation receipts and imported Runtime files such as NR models and Streamline. NeuRotic will restart. Installed game files are untouched.",
      "id": "desktop.hubshell.clears_the_local_library_including_hidden_games__516f3998",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [
        "NeuRotic"
      ],
      "revision": 1,
      "section": "hubshell",
      "surface": "desktop",
      "translation": "Löscht die lokale Bibliothek (einschließlich ausgeblendeter Spiele), Einstellungen, Spielprofile, Grafiken, Vorgangsbelege und importierte Laufzeitdateien wie NR-Modelle und Streamline. NeuRotic wird neu gestartet. Installierte Spieldateien bleiben unangetastet."
    },
