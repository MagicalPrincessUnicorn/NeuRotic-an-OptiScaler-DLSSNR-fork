      "surface": "in_game",
      "translation": "que o quadro possui e que o modelo nunca viu. Quanto menor a resolução do modelo, o"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "label",
      "english": "The game's own exposure",
