    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "label",
      "english": "Upscales the image internally to a higher output resolution",
      "id": "ingame.menu-common.upscales_the_image_internally_to_a_higher_output_1bbfcfb2",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Faz o upscale da imagem internamente para uma resolução de saída maior"
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "paragraph",
      "english": "Upscales the image internally to a higher output resolution\nthen downscales it back to your display resolution\n\nValues <1.0 make the upscaler cheaper\nValues >1.0 make image sharper at the cost of performance\n\nIf greyed out, please check Git Wiki - Unreal Engine tweaks\n\nTarget res and total ratio at the bottom (max. total 3.0!)",
      "id": "ingame.menu-common.upscales_the_image_internally_to_a_higher_output_85208d7c",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Faz o upscale da imagem internamente para uma resolução de saída maior\ndepois faz o downscale de volta para a resolução da sua tela\n\nValores <1.0 deixam o upscaler mais leve\nValores >1.0 deixam a imagem mais nítida ao custo de desempenho\n\nSe estiver esmaecido, verifique na Wiki do Git - Tweaks da Unreal Engine\n\nRes. alvo e proporção total na parte inferior (máx. total de 3.0!)"
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "label",
      "english": "Upscaling for the masses, not the classes",
      "id": "ingame.menu-common.upscaling_for_the_masses_not_the_classes_86fb2d3a",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Upscaling para as massas, não para as classes"
    },
