      "placeholders": [],
      "preserve": [],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "tools/packaging/customer/support/NeuRotic-InstallDefaults.ps1",
          "line": 46,
          "kind": "typed-message-producer"
        }
      ],
      "translation": "Não foi possível ler os padrões de instalação. Foram usados os padrões do pacote; o arquivo de preferências foi preservado.",
      "note": "Machine draft; semantic and native-speaker review pending."
    }
