    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_StageControls.h",
      "control": "paragraph",
      "english": "Present works on the final image after upscaling. It can add a stronger visual effect",
      "id": "ingame.dlssnr-stagecontrols.present_works_on_the_final_image_after_upscaling_67ed779d",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-stagecontrols",
      "surface": "in_game",
      "translation": "O Present atua na imagem final após o upscaling. Ele pode adicionar um efeito visual mais forte"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_StageControls.h",
      "control": "paragraph",
      "english": "provide usable motion information. It uses qualified depth and motion guides when available",
      "id": "ingame.dlssnr-stagecontrols.provide_usable_motion_information_it_uses_qualif_955cadf6",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-stagecontrols",
      "surface": "in_game",
      "translation": "enviar dados de movimento adequados. Ele utiliza guias de profundidade e movimento qualificados quando disponíveis"
    },
