    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "paragraph",
      "english": "bright highlights instead of everywhere. Most of Replace's detail, far more",
      "id": "ingame.dlssnr-menu.bright_highlights_instead_of_everywhere_most_of__790014de",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
