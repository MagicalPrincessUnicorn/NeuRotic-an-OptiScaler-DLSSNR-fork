    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_StageControls.h",
      "control": "status",
      "english": "This legacy placement is preserved. Ray Reconstruction and native Vulkan use NR after reconstruction; choose Full output or Manual to update it.",
      "id": "ingame.dlssnr-stagecontrols.this_legacy_placement_is_preserved_ray_reconstru_a9c0abcb",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-stagecontrols",
      "surface": "in_game",
      "translation": "Esse posicionamento legado é preservado. A Reconstrução de Raios e o Vulkan nativo usam o NR após a reconstrução; escolha Saída completa ou Manual para atualizá-lo."
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_StageControls.h",
      "control": "paragraph",
      "english": "while remaining fast, but moving objects may flicker or ghost when the game does not",
      "id": "ingame.dlssnr-stagecontrols.while_remaining_fast_but_moving_objects_may_flic_a4fadde2",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-stagecontrols",
      "surface": "in_game",
      "translation": "e se manter rápido, contudo objetos em movimento podem piscar ou gerar rastro (\"ghosting\") quando o jogo não"
    },
    {
      "context": "Current UI: OptiScaler/menu/ExperimentalMfgControls.h",
      "control": "label",
      "english": "Confirm experimental GPU compatibility",
      "id": "ingame.experimentalmfgcontrols.confirm_experimental_gpu_compatibility_673dc4f5",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "experimentalmfgcontrols",
      "surface": "in_game",
      "translation": "Confirmar compatibilidade experimental com GPU"
    },
    {
      "context": "Current UI: OptiScaler/menu/ExperimentalMfgControls.h",
      "control": "paragraph",
      "english": "Confirmed GPU-corruption safety checks remain active. This choice applies only after you agree. Save settings and restart the game; this does not prove provider support or displayed frame delivery. Do not combine external unlockers.",
      "id": "ingame.experimentalmfgcontrols.confirmed_gpu_corruption_safety_checks_remain_ac_a0d2454c",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "experimentalmfgcontrols",
      "surface": "in_game",
      "translation": "As verificações confirmadas de segurança contra corrupção da GPU permanecem ativas. Esta escolha se aplica somente após sua concordância. Salve as configurações e reinicie o jogo; isso não prova que há suporte pelo provedor ou a entrega de quadros exibidos. Não combine desbloqueadores externos."
    },
    {
      "context": "Current UI: OptiScaler/menu/ExperimentalMfgControls.h",
      "control": "paragraph",
      "english": "Enable the selected experimental options? These paths are untested or still under development and may cause instability or crashes.",
      "id": "ingame.experimentalmfgcontrols.enable_the_selected_experimental_options_these_p_fc7015ea",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "experimentalmfgcontrols",
      "surface": "in_game",
      "translation": "Ativar as opções experimentais selecionadas? Esses caminhos não foram testados ou ainda estão em desenvolvimento e podem causar instabilidade ou travamentos."
    },
