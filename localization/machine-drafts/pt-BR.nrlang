      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "Aumente até que a imagem pare de melhorar. Passando desse ponto não vai"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "paragraph",
      "english": "rarely anywhere near 1. Measured in Monster Hunter Wilds it takes 16 or more",
