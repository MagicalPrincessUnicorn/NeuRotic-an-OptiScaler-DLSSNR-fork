    {
      "context": "Current UI: apps/NeuRoticHub/ui/HubShell.cpp",
      "control": "paragraph",
      "english": "Clears saved game inspection and profile data. The library, hidden games and settings inside each game's folder stay unchanged. Fresh details will be read the next time you select a game. No restart is needed.",
      "id": "desktop.hubshell.clears_saved_game_inspection_and_profile_data_th_b9afdcd0",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "hubshell",
      "surface": "desktop",
      "translation": "Limpa os dados salvos de inspeção e perfil do jogo. A biblioteca, os jogos ocultos e as configurações dentro da pasta de cada jogo permanecem inalterados. Detalhes novos serão lidos na próxima vez que você selecionar um jogo. Nenhuma reinicialização é necessária."
    },
    {
      "context": "Current UI: apps/NeuRoticHub/ui/HubShell.cpp",
      "control": "paragraph",
      "english": "Clears the local library (including hidden games), preferences, game profiles, artwork, operation receipts and imported Runtime files such as NR models and Streamline. NeuRotic will restart. Installed game files are untouched.",
      "id": "desktop.hubshell.clears_the_local_library_including_hidden_games__516f3998",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [
        "NeuRotic"
      ],
      "revision": 1,
      "section": "hubshell",
      "surface": "desktop",
      "translation": "Limpa a biblioteca local (incluindo jogos ocultos), preferências, perfis de jogo, artes, recibos de operação e arquivos de Runtime importados, como modelos NR e Streamline. O NeuRotic será reiniciado. Os arquivos de jogos instalados não são afetados."
    },
