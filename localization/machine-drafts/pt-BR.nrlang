    {
      "context": "Saved next-launch preference: DLSSG/ExperimentalUnlockRTX20",
      "control": "paragraph",
      "english": "Default off. Saves compatibility intent for the next launch; close and restart the game. Requires a matching RTX 20 renderer, qualified provider and the game's native DirectX 12 Streamline DLSS Frame Generation route, with FG Input and Output set to None and replacement FG disabled. Enable FG and choose ratios through the existing game and in-game controls. This preference does not change routes or enable FG. Dynamic MFG is unavailable. Do not combine external unlockers. Gameplay qualification remains pending; an active backend remains loaded until exit.",
      "id": "desktop.settings.dlssg/experimentalunlockrtx20.93eb0cfac0",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [
        "DLSS"
      ],
      "revision": 1,
      "section": "saved-settings",
      "surface": "desktop",
      "translation": "Padrão desativado. Salva a intenção de compatibilidade para a próxima inicialização; feche e reinicie o jogo. Requer um renderizador RTX 20 correspondente, provedor qualificado e a rota nativa DirectX 12 Streamline DLSS Frame Generation do jogo, com FG Input e Output definidos como None e o substituto de FG desativado. Habilite o FG e escolha as taxas através dos controles existentes do jogo e do menu in-game. Esta preferência não altera rotas nem habilita o FG. Dynamic MFG indisponível. Não combine com desbloqueadores externos. A qualificação de gameplay permanece pendente; um backend ativo permanece carregado até a saída."
    },
    {
      "context": "Saved next-launch preference: DLSSG/ExperimentalUnlockRTX30",
      "control": "paragraph",
      "english": "Default off. Saves compatibility intent for the next launch; close and restart the game. Requires a matching RTX 30 renderer, qualified provider and the game's native DirectX 12 Streamline DLSS Frame Generation route, with FG Input and Output set to None and replacement FG disabled. Enable FG and choose ratios through the existing game and in-game controls. This preference does not change routes or enable FG. Dynamic MFG is unavailable. Do not combine external unlockers. Gameplay qualification remains pending; an active backend remains loaded until exit.",
      "id": "desktop.settings.dlssg/experimentalunlockrtx30.ea4a24c440",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [
        "DLSS"
      ],
      "revision": 1,
      "section": "saved-settings",
      "surface": "desktop",
      "translation": "Padrão desativado. Salva a intenção de compatibilidade para a próxima inicialização; feche e reinicie o jogo. Requer um renderizador RTX 30 correspondente, provedor qualificado e a rota nativa DirectX 12 Streamline DLSS Frame Generation do jogo, com FG Input e Output definidos como None e o substituto de FG desativado. Habilite o FG e escolha as taxas através dos controles existentes do jogo e do menu in-game. Esta preferência não altera rotas nem habilita o FG. Dynamic MFG indisponível. Não combine com desbloqueadores externos. A qualificação de gameplay permanece pendente; um backend ativo permanece carregado até a saída."
    },
    {
      "context": "Saved next-launch preference: DLSSG/NativeMfgExperimental",
      "control": "paragraph",
      "english": "Default off. Saves an unlock request for the next launch; close and restart the game. Requires RTX 40, DirectX 12 and a qualified provider. Use the game's native DLSS Frame Generation with FG Input and Output set to None and replacement FG disabled in the in-game menu. Enable FG in the game's settings. This preference does not change routes or prove that higher ratios are available. Use the existing in-game ratio controls. An applied unlock remains until the game exits.",
      "id": "desktop.settings.dlssg/nativemfgexperimental.03f484d593",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [
        "DLSS"
      ],
      "revision": 1,
      "section": "saved-settings",
      "surface": "desktop",
      "translation": "Padrão desativado. Salva uma solicitação de desbloqueio para a próxima inicialização; feche e reinicie o jogo. Requer RTX 40, DirectX 12 e um provedor qualificado. Use a DLSS Frame Generation nativa do jogo com FG Input e Output definidos como None e substituto de FG desativado no menu in-game. Habilite o FG nas configurações do jogo. Esta preferência não altera rotas nem comprova que taxas maiores estão disponíveis. Use os controles de taxa in-game existentes. Um desbloqueio aplicado permanece até o jogo ser encerrado."
    },
    {
      "context": "Saved next-launch preference: DLSSG/NativeMfgExperimental/value",
      "control": "label",
      "english": "Off",
      "id": "desktop.settings.dlssg/nativemfgexperimental/value.ca7981b46e",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "saved-settings",
      "surface": "desktop",
      "translation": "Desativado"
    },
