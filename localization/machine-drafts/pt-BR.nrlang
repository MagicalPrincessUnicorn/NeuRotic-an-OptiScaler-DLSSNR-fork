    {
      "context": "Current UI: tools/packaging/customer/support/NeuRotic-HubSettings.ps1",
      "control": "paragraph",
      "english": "Restores graphics state after injected rendering work. Automatic retains the existing default; select a manual value only for a known game compatibility requirement.",
      "id": "desktop.neurotic-hubsettings.restores_graphics_state_after_injected_rendering_6937c25c",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "neurotic-hubsettings",
      "surface": "desktop",
      "translation": "Restaura o estado gráfico após trabalho de renderização injetado. Automático retém o padrão existente; selecione um valor manual apenas para um requisito de compatibilidade de jogo conhecido."
    },
    {
      "context": "Current UI: tools/packaging/customer/support/NeuRotic-HubSettings.ps1",
      "control": "paragraph",
      "english": "Restricts NGX interception to original NVIDIA library names. Change only for a known loader conflict; Automatic retains the existing default.",
      "id": "desktop.neurotic-hubsettings.restricts_ngx_interception_to_original_nvidia_li_f03287e8",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "neurotic-hubsettings",
      "surface": "desktop",
      "translation": "Restringe a interceptação do NGX aos nomes de biblioteca NVIDIA originais. Altere apenas para um conflito de carregador conhecido; Automático retém o padrão existente."
    },
    {
      "context": "Current UI: tools/packaging/customer/support/NeuRotic-HubSettings.ps1",
      "control": "label",
      "english": "Reuse one log file",
      "id": "desktop.neurotic-hubsettings.reuse_one_log_file_1f88d3d3",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "neurotic-hubsettings",
      "surface": "desktop",
      "translation": "Reutilizar um arquivo de log"
    },
    {
      "context": "Current UI: tools/packaging/customer/support/NeuRotic-HubSettings.ps1",
      "control": "paragraph",
      "english": "Route dependent: non-linear depth uses 0.0001–0.003; linear depth uses 0.005–0.03. The running upscaler determines the depth format. Values in the gap are refused.",
      "id": "desktop.neurotic-hubsettings.route_dependent_non_linear_depth_uses_0_0001_0_0_bdcc6a62",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "neurotic-hubsettings",
      "surface": "desktop",
      "translation": "Dependente da rota: profundidade não linear usa 0.0001–0.003; profundidade linear usa 0.005–0.03. O upscaler em execução determina o formato de profundidade. Valores na lacuna são recusados."
    },
    {
      "context": "Current UI: tools/packaging/customer/support/NeuRotic-HubSettings.ps1",
      "control": "paragraph",
      "english": "Route dependent: non-linear depth uses 25–400; linear depth uses 100–600. This editor exposes the union without claiming the active depth format.",
      "id": "desktop.neurotic-hubsettings.route_dependent_non_linear_depth_uses_25_400_lin_84a64a4b",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "neurotic-hubsettings",
      "surface": "desktop",
      "translation": "Dependente da rota: profundidade não linear usa 25–400; profundidade linear usa 100–600. Este editor expõe a união sem reivindicar o formato de profundidade ativo."
    },
    {
      "context": "Current UI: tools/packaging/customer/support/NeuRotic-HubSettings.ps1",
      "control": "paragraph",
      "english": "s native DLSS Frame Generation with FG Input and Output set to None and replacement FG disabled in the in-game menu. Enable FG in the game",
      "id": "desktop.neurotic-hubsettings.s_native_dlss_frame_generation_with_fg_input_and_b8a2ffa8",
      "line_breaks": true,
