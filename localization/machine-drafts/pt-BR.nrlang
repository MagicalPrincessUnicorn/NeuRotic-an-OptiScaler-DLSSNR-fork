    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "paragraph",
      "english": "Some Unreal Engine games need this\n\nTry using if colours flickering or\nobjects have ghosting trails",
      "id": "ingame.menu-common.some_unreal_engine_games_need_this_try_using_if__a1ea5ccf",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Alguns jogos na Unreal Engine precisam disso\n\nTente usar se as cores estiverem piscando (flickering) ou\nobjetos tiverem rastros de ghosting"
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "label",
      "english": "Some upscalers have their own sharpness filter, so this",
      "id": "ingame.menu-common.some_upscalers_have_their_own_sharpness_filter_s_90a89a4c",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Alguns upscalers possuem seu próprio filtro de nitidez, então isso"
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "paragraph",
      "english": "Specialised to prevent artifacts.\nEliminates harsh halos for a natural look, but can appear slightly soft.",
      "id": "ingame.menu-common.specialised_to_prevent_artifacts_eliminates_hars_471108f7",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Especializado em prevenir artefatos.\nElimina halos agressivos para um visual natural, mas pode parecer um pouco suave."
    },
