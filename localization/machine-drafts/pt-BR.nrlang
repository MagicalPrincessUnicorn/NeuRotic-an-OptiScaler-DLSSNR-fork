    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "label",
      "english": "Enable OptiScaler's sharpening filter",
      "id": "ingame.menu-common.enable_optiscaler_s_sharpening_filter_3bf607a0",
