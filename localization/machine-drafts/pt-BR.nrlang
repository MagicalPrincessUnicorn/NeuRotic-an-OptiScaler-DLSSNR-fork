      "surface": "in_game",
      "translation": "(a varredura está apenas observando -- o ponto branco acima vem"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "paragraph",
      "english": "(the scan is only watching -- the white point above comes from somewhere else)",
      "id": "ingame.dlssnr-menu.the_scan_is_only_watching_the_white_point_above__32fa3a87",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
