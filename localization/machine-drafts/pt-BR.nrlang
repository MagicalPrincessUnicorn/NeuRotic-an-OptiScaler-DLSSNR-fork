    },
    {
      "context": "Current UI: apps/NeuRoticHub/ui/GameSettingsView.h",
      "control": "label",
      "english": "Startup Options for This Game",
      "id": "desktop.gamesettingsview.startup_options_for_this_game_b3d2ff6c",
      "line_breaks": false,
      "placeholders": [],
