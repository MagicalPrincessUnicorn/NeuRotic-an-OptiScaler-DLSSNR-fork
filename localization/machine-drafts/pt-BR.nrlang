    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "paragraph",
      "english": "Controls apply to the active replacement backend. Provider activity does not establish displayed frame delivery.",
      "id": "ingame.menu-common.controls_apply_to_the_active_replacement_backend_e7fdb9ac",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Os controles se aplicam ao backend de substituição ativo. A atividade do provedor não estabelece a entrega de quadros exibidos."
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "paragraph",
      "english": "Controls how strongly sharpening is reduced across depth edges.\n\nHigher values more aggressively prevent sharpening across object boundaries (reduces halos).\nLower values allow more sharpening to pass across edges (sharper but riskier).",
      "id": "ingame.menu-common.controls_how_strongly_sharpening_is_reduced_acro_49743ae3",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Controla a intensidade da redução da nitidez através das bordas de profundidade.\n\nValores mais altos evitam de forma mais agressiva a nitidez nos limites dos objetos (reduz halos).\nValores mais baixos permitem que mais nitidez passe pelas bordas (mais nítido, porém mais arriscado)."
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "label",
      "english": "Controls how strongly sharpening is reduced across depth edges.",
      "id": "ingame.menu-common.controls_how_strongly_sharpening_is_reduced_acro_965fed7b",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Controla a intensidade da redução de nitidez através das bordas de profundidade."
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "label",
      "english": "Controls sharpness at high contrast areas.",
      "id": "ingame.menu-common.controls_sharpness_at_high_contrast_areas_a23b00e2",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Controla a nitidez em áreas de alto contraste."
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "label",
      "english": "Cope smarter, not harder",
      "id": "ingame.menu-common.cope_smarter_not_harder_ab9f08e7",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Lide de forma mais inteligente, não mais difícil"
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "label",
      "english": "Coping is strong with this one...",
      "id": "ingame.menu-common.coping_is_strong_with_this_one_8c12616d",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "A superação é forte com este..."
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "label",
      "english": "Corresponds to amount of accumulation added per frame",
      "id": "ingame.menu-common.corresponds_to_amount_of_accumulation_added_per__48f6baf5",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Corresponde à quantidade de acumulação adicionada por quadro"
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "paragraph",
      "english": "Corresponds to amount of accumulation added per frame\nat pixel coordinate where disocclusion occured or when\nreactive mask value is > 0.0f. Decreasing this and \ndrawing the ghosting object (IE no mv) to reactive mask \nwith value close to 1.0f can decrease temporal ghosting.\nDecreasing this could result in more thin feature pixels flickering.",
      "id": "ingame.menu-common.corresponds_to_amount_of_accumulation_added_per__a71e0ab2",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Corresponde à quantidade de acumulação adicionada por quadro\nna coordenada do pixel onde ocorreu a desoclusão ou quando\no valor da máscara reativa for > 0.0f. Diminuir isso e \ndesenhar o objeto com ghosting (ou seja, sem mv) para a máscara reativa \ncom valor próximo a 1.0f pode diminuir o ghosting temporal.\nDiminuir isso pode resultar em mais cintilação de pixels de recursos finos."
    },
