    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "paragraph",
      "english": "Similar to Lanczos2.\nSmoother and less prone to artefacts than Lanczos, but slightly blurrier.",
      "id": "ingame.menu-common.similar_to_lanczos2_smoother_and_less_prone_to_a_b68bcd9e",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Semelhante ao Lanczos2.\nMais suave e menos propenso a artefatos que o Lanczos, mas levemente mais borrado."
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "paragraph",
      "english": "Similar to Lanczos3.\nFar less prone to artefacting than Lanczos3, but much heavier on the GPU.\nConsidered the best along with Lanczos3.",
      "id": "ingame.menu-common.similar_to_lanczos3_far_less_prone_to_artefactin_0d2c10d6",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Semelhante ao Lanczos3.\nMuito menos propenso a gerar artefatos que o Lanczos3, mas muito mais pesado para a GPU.\nConsiderado o melhor junto com o Lanczos3."
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "paragraph",
      "english": "Similar to preset K. Preset J might exhibit slightly\nless ghosting...\n1st Gen Transformer",
      "id": "ingame.menu-common.similar_to_preset_k_preset_j_might_exhibit_sligh_26e8a97a",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "Semelhante ao preset K. O preset J pode exibir um pouco\nmenos de ghosting...\n1st Gen Transformer"
    },
