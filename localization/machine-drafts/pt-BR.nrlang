      "placeholders": [],
      "preserve": [
        "dxgi.dll",
        "ReShade"
      ],
      "revision": 1,
      "section": "neurotic-hubsettings",
      "surface": "desktop",
      "translation": "Carrega ReShade64.dll ao lado do executável do jogo na inicialização. Não instala, renomeia ou identifica arquivos ReShade. Use a opção de coexistência do instalador se um dxgi.dll existente precisar ser renomeado. Automático usa o padrão existente (desligado)."
    },
