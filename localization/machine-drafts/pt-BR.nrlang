    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_StageControls.h",
      "control": "paragraph",
      "english": "Some setups place it after reconstruction. It is usually more stable during motion,",
      "id": "ingame.dlssnr-stagecontrols.some_setups_place_it_after_reconstruction_it_is__40bf4b75",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-stagecontrols",
      "surface": "in_game",
      "translation": "Algumas configurações o posicionam após a reconstrução. Costuma ser mais estável em movimento,"
    },
    {
