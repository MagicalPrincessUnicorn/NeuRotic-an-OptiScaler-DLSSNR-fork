    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "label",
      "english": "Flip this if the picture gets worse in the direction it should be",
      "id": "ingame.dlssnr-menu.flip_this_if_the_picture_gets_worse_in_the_direc_84d2d31e",
      "line_breaks": false,
      "placeholders": [],
