      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "characterinspectormenu",
      "surface": "in_game",
      "translation": "O rastreamento perdido limpa uma caixa. Um curto período de tolerância preenche perdas de detecção confiáveis; zero desativa isso."
    },
