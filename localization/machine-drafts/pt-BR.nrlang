      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "raramente chega perto de 1. Medido em Monster Hunter Wilds leva 16 ou mais"
