    },
    {
      "context": "Current UI: apps/NeuRoticHub/ui/GameSettingsView.h",
      "control": "paragraph",
      "english": "The existing profile is preserved. Resolve duplicate or invalid Object Rules entries in OptiScaler.ini before editing.",
      "id": "desktop.gamesettingsview.the_existing_profile_is_preserved_resolve_duplic_feed7f2c",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [
        "OptiScaler.ini"
      ],
      "revision": 1,
      "section": "gamesettingsview",
      "surface": "desktop",
      "translation": "O perfil existente é preservado. Resolva as entradas duplicadas ou inválidas de Regras de objeto no OptiScaler.ini antes de editar."
    },
    {
      "context": "Current UI: apps/NeuRoticHub/ui/GameSettingsView.h",
      "control": "paragraph",
      "english": "The game loader reads AFModifyComparison while its saver writes ModifyComparison. Both existing keys remain preserved until this mismatch is resolved.",
      "id": "desktop.gamesettingsview.the_game_loader_reads_afmodifycomparison_while_i_c363b7b2",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "gamesettingsview",
      "surface": "desktop",
      "translation": "O carregador do jogo lê AFModifyComparison enquanto seu salvador grava ModifyComparison. Ambas as chaves existentes permanecem preservadas até que esta incompatibilidade seja resolvida."
    },
    {
      "context": "Current UI: apps/NeuRoticHub/ui/GameSettingsView.h",
      "control": "paragraph",
      "english": "The game loader reads AFModifyMinMax while its saver writes ModifyMinMax. Both existing keys remain preserved until this mismatch is resolved.",
      "id": "desktop.gamesettingsview.the_game_loader_reads_afmodifyminmax_while_its_s_7d42b506",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "gamesettingsview",
      "surface": "desktop",
      "translation": "O carregador do jogo lê AFModifyMinMax enquanto seu salvador grava ModifyMinMax. Ambas as chaves existentes permanecem preservadas até que esta incompatibilidade seja resolvida."
    },
    {
      "context": "Current UI: apps/NeuRoticHub/ui/GameSettingsView.h",
      "control": "paragraph",
      "english": "The in-game control is unbounded. No validated portable provider range is defined, so its saved value remains preserved.",
      "id": "desktop.gamesettingsview.the_in_game_control_is_unbounded_no_validated_po_8664cbde",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "gamesettingsview",
      "surface": "desktop",
      "translation": "O controle do jogo não tem limites. Não há definição de intervalo validado de provedor portátil, portanto seu valor salvo permanece preservado."
    },
    {
      "context": "Current UI: apps/NeuRoticHub/ui/GameSettingsView.h",
      "control": "paragraph",
      "english": "The valid rectangle depends on the game's current frame dimensions and active frame-generation provider.",
      "id": "desktop.gamesettingsview.the_valid_rectangle_depends_on_the_game_s_curren_30f2fc17",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "gamesettingsview",
      "surface": "desktop",
      "translation": "O retângulo válido depende das dimensões do quadro atual do jogo e do provedor ativo de geração de quadros."
    },
    {
      "context": "Current UI: apps/NeuRoticHub/ui/GameSettingsView.h",
      "control": "paragraph",
      "english": "This entry is preserved: duplicate keys/sections or a value that cannot be safely edited here. Check OptiScaler.ini before editing this setting.",
      "id": "desktop.gamesettingsview.this_entry_is_preserved_duplicate_keys_sections__376ab0f6",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [
        "OptiScaler.ini"
      ],
      "revision": 1,
      "section": "gamesettingsview",
      "surface": "desktop",
      "translation": "Esta entrada é preservada: chaves/seções duplicadas ou um valor que não pode ser editado com segurança aqui. Verifique o OptiScaler.ini antes de editar esta configuração."
    },
    {
      "context": "Current UI: apps/NeuRoticHub/ui/GameSettingsView.h",
      "control": "paragraph",
      "english": "This saved profile is used only when Advanced Multipass includes this pass. Automatic values inherit the preceding pass when the game loads them.",
      "id": "desktop.gamesettingsview.this_saved_profile_is_used_only_when_advanced_mu_b8c1ac32",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "gamesettingsview",
      "surface": "desktop",
      "translation": "Este perfil salvo é usado apenas quando o Multipass Avançado inclui este passo. Os valores automáticos herdam o passo anterior quando o jogo os carrega."
    },
    {
      "context": "Current UI: apps/NeuRoticHub/ui/GameSettingsView.h",
      "control": "paragraph",
      "english": "This value divides active game depth. The in-game input is unbounded; a safe range cannot be inferred without its depth format.",
      "id": "desktop.gamesettingsview.this_value_divides_active_game_depth_the_in_game_43991363",
