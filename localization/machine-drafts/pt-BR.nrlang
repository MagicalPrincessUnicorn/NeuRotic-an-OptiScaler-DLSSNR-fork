      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "A própria exposição do jogo"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "label",
      "english": "The game's own exposure -- read from the texture the game hands",
      "id": "ingame.dlssnr-menu.the_game_s_own_exposure_read_from_the_texture_th_7cd3dfd9",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "A própria exposição do jogo -- lida a partir da textura que o jogo entrega"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "paragraph",
      "english": "The game upscaler feature is observable; this does not prove that NR inputs are qualified.",
