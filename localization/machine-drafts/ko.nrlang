    {
      "id": "ingame.menu-common.lets_you_override_each_preset_s_ratio_individual_7581c421",
      "surface": "in_game",
      "section": "menu-common",
      "control": "paragraph",
      "english": "Lets you override each preset's ratio individually\nNote that not every game supports every quality preset\n\n1.5x on a 1080p screen means internal resolution of 720p\n1080 / 1.5 = 720",
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "placeholders": [],
      "preserve": [],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "OptiScaler/menu/menu_common.cpp",
          "line": 5713,
          "kind": "presentation-binding"
        }
      ],
      "translation": "각 프리셋의 비율을 개별적으로 재정의할 수 있습니다\n모든 게임이 모든 품질 프리셋을 지원하는 것은 아닙니다\n\n1080p 화면에서 1.5x는 720p의 내부 해상도를 의미합니다\n1080 / 1.5 = 720",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
