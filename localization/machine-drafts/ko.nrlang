    {
      "id": "desktop.neurotic-hubsettings.loads_reshade64_dll_beside_the_game_executable_a_f7e24f36",
      "surface": "desktop",
      "section": "neurotic-hubsettings",
      "control": "paragraph",
      "english": "Loads ReShade64.dll beside the game executable at startup. Does not install, rename or identify ReShade files. Use the installer coexistence option if an existing dxgi.dll needs renaming. Automatic uses the existing default (off).",
      "context": "Current UI: tools/packaging/customer/support/NeuRotic-HubSettings.ps1",
      "placeholders": [],
      "preserve": [
        "dxgi.dll",
        "ReShade"
      ],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "tools/packaging/customer/support/NeuRotic-HubSettings.ps1",
          "line": 276,
          "kind": "backend"
        }
      ],
      "translation": "시작 시 게임 실행 파일 옆에 ReShade64.dll을 로드합니다. ReShade 파일을 설치, 이름 변경 또는 식별하지 않습니다. 기존 dxgi.dll의 이름을 변경해야 하는 경우 설치 관리자 공존 옵션을 사용하십시오. 자동은 기존 기본값(꺼짐)을 사용합니다.",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
