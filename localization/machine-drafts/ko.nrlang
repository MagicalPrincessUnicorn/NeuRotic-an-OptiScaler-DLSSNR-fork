    {
      "id": "desktop.hubshell.clears_saved_game_inspection_and_profile_data_th_b9afdcd0",
      "surface": "desktop",
      "section": "hubshell",
      "control": "paragraph",
      "english": "Clears saved game inspection and profile data. The library, hidden games and settings inside each game's folder stay unchanged. Fresh details will be read the next time you select a game. No restart is needed.",
      "context": "Current UI: apps/NeuRoticHub/ui/HubShell.cpp",
      "placeholders": [],
      "preserve": [],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "apps/NeuRoticHub/ui/HubShell.cpp",
          "line": 320,
          "kind": "presentation-binding"
        }
      ],
      "translation": "저장된 게임 검사 및 프로필 데이터를 지웁니다. 라이브러리, 숨겨진 게임 및 각 게임 폴더 내의 설정은 변경되지 않습니다. 다음에 게임을 선택할 때 새로운 세부 정보가 읽힙니다. 다시 시작할 필요가 없습니다.",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
    {
      "id": "desktop.hubshell.clears_the_local_library_including_hidden_games__516f3998",
      "surface": "desktop",
      "section": "hubshell",
      "control": "paragraph",
      "english": "Clears the local library (including hidden games), preferences, game profiles, artwork, operation receipts and imported Runtime files such as NR models and Streamline. NeuRotic will restart. Installed game files are untouched.",
      "context": "Current UI: apps/NeuRoticHub/ui/HubShell.cpp",
      "placeholders": [],
      "preserve": [
        "NeuRotic"
      ],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "apps/NeuRoticHub/ui/HubShell.cpp",
          "line": 319,
          "kind": "presentation-binding"
        }
      ],
      "translation": "로컬 라이브러리(숨겨진 게임 포함), 환경 설정, 게임 프로필, 아트워크, 작업 영수증 및 NR 모델, Streamline과 같이 가져온 런타임 파일을 지웁니다. NeuRotic이 다시 시작됩니다. 설치된 게임 파일은 그대로 유지됩니다.",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
