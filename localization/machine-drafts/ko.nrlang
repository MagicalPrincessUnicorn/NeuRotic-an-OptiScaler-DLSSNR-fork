    {
      "id": "ingame.menu-common.makes_a_copy_of_the_depth_buffer_can_fix_broken__0bd04419",
      "surface": "in_game",
      "section": "menu-common",
      "control": "paragraph",
      "english": "Makes a copy of the depth buffer\nCan fix broken visuals in some games on AMD GPUs under Windows\nCan cause stutters, so best to use only when necessary",
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "placeholders": [],
      "preserve": [],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "OptiScaler/menu/menu_common.cpp",
          "line": 4679,
          "kind": "presentation-binding"
        }
      ],
      "translation": "깊이 버퍼의 복사본을 만듭니다\nWindows 환경의 AMD GPU에서 일부 게임의 깨진 시각 효과를 수정할 수 있습니다\n끊김 현상을 유발할 수 있으므로 필요할 때만 사용하는 것이 가장 좋습니다",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
