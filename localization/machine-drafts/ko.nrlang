    {
      "id": "ingame.menu-common.can_help_with_blurry_textures_in_broken_games_ne_a14dd048",
      "surface": "in_game",
      "section": "menu-common",
      "control": "paragraph",
      "english": "Can help with blurry textures in broken games\nNegative values will make textures sharper\nPositive values will make textures more blurry\n\nHas a small performance impact",
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "placeholders": [],
      "preserve": [],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "OptiScaler/menu/menu_common.cpp",
          "line": 6960,
          "kind": "presentation-binding"
        }
      ],
      "translation": "손상된 게임의 흐릿한 텍스처에 도움이 될 수 있습니다.\n음수 값은 텍스처를 더 선명하게 만듭니다.\n양수 값은 텍스처를 더 흐리게 만듭니다.\n\n성능에 약간의 영향을 미칩니다.",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
