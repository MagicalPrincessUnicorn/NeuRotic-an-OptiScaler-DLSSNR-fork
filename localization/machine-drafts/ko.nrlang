    },
    {
      "id": "ingame.dlssnr-menu.chooses_how_a_sub_native_model_edit_returns_to_f_28680eb0",
      "surface": "in_game",
      "section": "dlssnr-menu",
      "control": "tooltip",
      "english": "Chooses how a sub-native model edit returns to full size. Matched residual enlarges only the model's difference and generally preserves colour better.",
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "placeholders": [],
      "preserve": [],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "OptiScaler/dlssnr/DlssNr_Menu.cpp",
          "line": 3295,
          "kind": "presentation-binding"
        }
      ],
      "translation": "서브 네이티브 모델 편집을 전체 크기로 복원하는 방법을 선택합니다. Matched residual은 모델의 차이점만 확대하며 일반적으로 색상을 더 잘 보존합니다.",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
    {
      "id": "ingame.dlssnr-menu.chooses_the_filter_that_averages_this_pass_s_abo_5580a1dd",
      "surface": "in_game",
      "section": "dlssnr-menu",
      "control": "tooltip",
      "english": "Chooses the filter that averages this pass's above-native model answer back to the full-resolution frame. It applies only above 100 percent.",
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "placeholders": [],
      "preserve": [],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "OptiScaler/dlssnr/DlssNr_Menu.cpp",
          "line": 3269,
          "kind": "presentation-binding"
        }
      ],
      "translation": "이 패스의 네이티브 이상 모델 응답을 전체 해상도 프레임으로 다시 평균화하는 필터를 선택합니다. 100퍼센트를 초과하는 경우에만 적용됩니다.",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
    {
