      "section": "dlssnr-menu",
      "control": "label",
      "english": "Choose a target and analyze the current game scene.",
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "placeholders": [],
      "preserve": [],
      "line_breaks": false,
      "revision": 1,
      "sources": [
        {
          "path": "OptiScaler/dlssnr/DlssNr_Menu.cpp",
          "line": 459,
