      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "设置太低会导致几乎每个像素都触发软拐点（soft knee）：呈现给模型的是一幅"
