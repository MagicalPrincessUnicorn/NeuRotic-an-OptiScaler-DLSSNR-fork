    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "label",
      "english": "Clamps the final image to the [0, 1] range.",
      "id": "ingame.menu-common.clamps_the_final_image_to_the_0_1_range_2f61a603",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "将最终图像钳制在 [0, 1] 范围内。"
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "paragraph",
      "english": "Clamps the final image to the [0, 1] range.\n\nPrevents overshoot artifacts such as bright halos or negative colors.\nRecommended for LDR pipelines; optional for HDR depending on tone-mapping.\n\nWhen not set OptiScaler controls it via upscalers HDR flag",
      "id": "ingame.menu-common.clamps_the_final_image_to_the_0_1_range_prevents_e47bf852",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "将最终图像钳制在 [0, 1] 范围内。\n\n防止出现过冲伪影，例如明亮的光晕或负色。\n推荐用于 LDR 管线；对于 HDR 则可选，具体取决于色调映射。\n\n未设置时，OptiScaler 通过放大器 HDR 标志对其进行控制"
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "button",
      "english": "Clear",
      "id": "ingame.menu-common.clear_46ae3359",
