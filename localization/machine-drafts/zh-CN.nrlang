      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "dlssnr-menu",
      "surface": "in_game",
      "translation": "帧自身的代理上，因此比较的两幅画面都是全尺寸的，且唯一的"
    },
    {
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "control": "paragraph",
      "english": "frame. Those two disagree by the shrink's blur as well as by the model's edit,",
      "id": "ingame.dlssnr-menu.frame_those_two_disagree_by_the_shrink_s_blur_as_b0806dd1",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
