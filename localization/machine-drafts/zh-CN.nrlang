    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "paragraph",
      "english": "Defines the motion range over which the effect ramps from zero to full strength.",
      "id": "ingame.menu-common.defines_the_motion_range_over_which_the_effect_r_171a7e4c",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
