    {
      "context": "Current UI: apps/NeuRoticHub/ui/GameSettingsView.h",
      "control": "paragraph",
      "english": "The existing profile is preserved. Resolve duplicate or invalid Object Rules entries in OptiScaler.ini before editing.",
      "id": "desktop.gamesettingsview.the_existing_profile_is_preserved_resolve_duplic_feed7f2c",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [
        "OptiScaler.ini"
      ],
      "revision": 1,
      "section": "gamesettingsview",
      "surface": "desktop",
      "translation": "现有配置文件将保留。在编辑之前，请解决 OptiScaler.ini 中重复或无效的“对象规则”条目。"
    },
    {
      "context": "Current UI: apps/NeuRoticHub/ui/GameSettingsView.h",
      "control": "paragraph",
      "english": "The game loader reads AFModifyComparison while its saver writes ModifyComparison. Both existing keys remain preserved until this mismatch is resolved.",
      "id": "desktop.gamesettingsview.the_game_loader_reads_afmodifycomparison_while_i_c363b7b2",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "gamesettingsview",
      "surface": "desktop",
      "translation": "游戏加载程序读取 AFModifyComparison，而其保存程序写入 ModifyComparison。在解决此不匹配问题之前，这两个现有键均将保持保留状态。"
    },
    {
      "context": "Current UI: apps/NeuRoticHub/ui/GameSettingsView.h",
      "control": "paragraph",
      "english": "The game loader reads AFModifyMinMax while its saver writes ModifyMinMax. Both existing keys remain preserved until this mismatch is resolved.",
      "id": "desktop.gamesettingsview.the_game_loader_reads_afmodifyminmax_while_its_s_7d42b506",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "gamesettingsview",
      "surface": "desktop",
      "translation": "游戏加载程序读取 AFModifyMinMax，而其保存程序写入 ModifyMinMax。在解决此不匹配问题之前，这两个现有键均将保持保留状态。"
    },
    {
      "context": "Current UI: apps/NeuRoticHub/ui/GameSettingsView.h",
      "control": "paragraph",
      "english": "The in-game control is unbounded. No validated portable provider range is defined, so its saved value remains preserved.",
      "id": "desktop.gamesettingsview.the_in_game_control_is_unbounded_no_validated_po_8664cbde",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "gamesettingsview",
      "surface": "desktop",
      "translation": "游戏内控件不受限制。未定义经验证的可移植提供程序范围，因此其保存的值将保持保留状态。"
    },
    {
      "context": "Current UI: apps/NeuRoticHub/ui/GameSettingsView.h",
      "control": "paragraph",
      "english": "The valid rectangle depends on the game's current frame dimensions and active frame-generation provider.",
      "id": "desktop.gamesettingsview.the_valid_rectangle_depends_on_the_game_s_curren_30f2fc17",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "gamesettingsview",
      "surface": "desktop",
      "translation": "有效矩形取决于游戏当前帧的尺寸和活动的帧生成提供程序。"
    },
    {
      "context": "Current UI: apps/NeuRoticHub/ui/GameSettingsView.h",
      "control": "paragraph",
      "english": "This entry is preserved: duplicate keys/sections or a value that cannot be safely edited here. Check OptiScaler.ini before editing this setting.",
      "id": "desktop.gamesettingsview.this_entry_is_preserved_duplicate_keys_sections__376ab0f6",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [
