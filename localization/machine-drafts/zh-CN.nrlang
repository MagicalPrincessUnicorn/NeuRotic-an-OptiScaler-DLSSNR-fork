    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "label",
      "english": "Some Unreal Engine games need this",
      "id": "ingame.menu-common.some_unreal_engine_games_need_this_8a7e42a0",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "某些虚幻引擎游戏需要此项"
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "paragraph",
      "english": "Some Unreal Engine games need this\n\nTry using if colours flickering or\nobjects have ghosting trails",
      "id": "ingame.menu-common.some_unreal_engine_games_need_this_try_using_if__a1ea5ccf",
      "line_breaks": true,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "某些虚幻引擎游戏需要此项\n\n如果颜色闪烁或\n物体有拖影，请尝试使用"
    },
    {
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "control": "label",
      "english": "Some upscalers have their own sharpness filter, so this",
      "id": "ingame.menu-common.some_upscalers_have_their_own_sharpness_filter_s_90a89a4c",
      "line_breaks": false,
      "placeholders": [],
      "preserve": [],
      "revision": 1,
      "section": "menu-common",
      "surface": "in_game",
      "translation": "某些放大器有自己的锐度滤镜，因此这"
