    {
      "id": "desktop.gamesettingsview.the_game_loader_reads_afmodifycomparison_while_i_c363b7b2",
      "surface": "desktop",
      "section": "gamesettingsview",
      "control": "paragraph",
      "english": "The game loader reads AFModifyComparison while its saver writes ModifyComparison. Both existing keys remain preserved until this mismatch is resolved.",
      "context": "Current UI: apps/NeuRoticHub/ui/GameSettingsView.h",
      "placeholders": [],
      "preserve": [],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "apps/NeuRoticHub/ui/GameSettingsView.h",
          "line": 123,
          "kind": "presentation-binding"
        }
      ],
      "translation": "Le chargeur de jeu lit AFModifyComparison tandis que son enregistreur écrit ModifyComparison. Les deux clés existantes sont conservées jusqu'à ce que cette non-correspondance soit résolue.",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
    {
      "id": "desktop.gamesettingsview.the_game_loader_reads_afmodifyminmax_while_its_s_7d42b506",
