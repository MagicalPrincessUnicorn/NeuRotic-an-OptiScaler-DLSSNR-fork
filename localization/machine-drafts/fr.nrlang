    {
      "id": "desktop.neurotic-hubsettings.route_dependent_non_linear_depth_uses_0_0001_0_0_bdcc6a62",
      "surface": "desktop",
      "section": "neurotic-hubsettings",
      "control": "paragraph",
      "english": "Route dependent: non-linear depth uses 0.0001–0.003; linear depth uses 0.005–0.03. The running upscaler determines the depth format. Values in the gap are refused.",
      "context": "Current UI: tools/packaging/customer/support/NeuRotic-HubSettings.ps1",
      "placeholders": [],
      "preserve": [],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "tools/packaging/customer/support/NeuRotic-HubSettings.ps1",
          "line": 457,
          "kind": "backend"
        }
      ],
      "translation": "Dépendant de la route : la profondeur non linéaire utilise 0.0001–0.003 ; la profondeur linéaire utilise 0.005–0.03. L'upscaler en cours d'exécution détermine le format de profondeur. Les valeurs dans l'intervalle sont refusées.",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
    {
      "id": "desktop.neurotic-hubsettings.route_dependent_non_linear_depth_uses_25_400_lin_84a64a4b",
      "surface": "desktop",
      "section": "neurotic-hubsettings",
      "control": "paragraph",
      "english": "Route dependent: non-linear depth uses 25–400; linear depth uses 100–600. This editor exposes the union without claiming the active depth format.",
      "context": "Current UI: tools/packaging/customer/support/NeuRotic-HubSettings.ps1",
      "placeholders": [],
      "preserve": [],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "tools/packaging/customer/support/NeuRotic-HubSettings.ps1",
          "line": 458,
          "kind": "backend"
        }
      ],
      "translation": "Dépendant de la route : la profondeur non linéaire utilise 25–400 ; la profondeur linéaire utilise 100–600. Cet éditeur expose l'union sans revendiquer le format de profondeur actif.",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
