      "id": "ingame.menu-common.clamps_the_final_image_to_the_0_1_range_2f61a603",
      "surface": "in_game",
      "section": "menu-common",
      "control": "label",
      "english": "Clamps the final image to the [0, 1] range.",
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "placeholders": [],
      "preserve": [],
      "line_breaks": false,
      "revision": 1,
