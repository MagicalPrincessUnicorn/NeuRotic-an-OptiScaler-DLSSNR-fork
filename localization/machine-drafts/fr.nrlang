    {
      "id": "desktop.settings.dlssg/experimentalunlockrtx20.93eb0cfac0",
      "surface": "desktop",
      "section": "saved-settings",
      "control": "paragraph",
      "english": "Default off. Saves compatibility intent for the next launch; close and restart the game. Requires a matching RTX 20 renderer, qualified provider and the game's native DirectX 12 Streamline DLSS Frame Generation route, with FG Input and Output set to None and replacement FG disabled. Enable FG and choose ratios through the existing game and in-game controls. This preference does not change routes or enable FG. Dynamic MFG is unavailable. Do not combine external unlockers. Gameplay qualification remains pending; an active backend remains loaded until exit.",
      "context": "Saved next-launch preference: DLSSG/ExperimentalUnlockRTX20",
      "placeholders": [],
      "preserve": [
        "DLSS"
      ],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "tools/packaging/customer/support/NeuRotic-HubSettings.ps1",
          "line": 0,
          "kind": "typed metadata"
        }
      ],
      "translation": "Désactivé par défaut. Enregistre l'intention de compatibilité pour le prochain lancement ; fermez et redémarrez le jeu. Nécessite un moteur de rendu RTX 20 correspondant, un fournisseur qualifié et la voie DLSS Frame Generation Streamline DirectX 12 native du jeu, avec Entrée et Sortie FG définies sur Aucun et FG de remplacement désactivé. Activez FG et choisissez les ratios via le jeu existant et les contrôles en jeu. Cette préférence ne modifie pas les voies et n'active pas FG. Dynamic MFG est indisponible. Ne pas combiner avec des déverrouilleurs externes. La qualification de gameplay reste en attente ; un backend actif reste chargé jusqu'à la sortie.",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
    {
      "id": "desktop.settings.dlssg/experimentalunlockrtx30.ea4a24c440",
      "surface": "desktop",
      "section": "saved-settings",
      "control": "paragraph",
      "english": "Default off. Saves compatibility intent for the next launch; close and restart the game. Requires a matching RTX 30 renderer, qualified provider and the game's native DirectX 12 Streamline DLSS Frame Generation route, with FG Input and Output set to None and replacement FG disabled. Enable FG and choose ratios through the existing game and in-game controls. This preference does not change routes or enable FG. Dynamic MFG is unavailable. Do not combine external unlockers. Gameplay qualification remains pending; an active backend remains loaded until exit.",
      "context": "Saved next-launch preference: DLSSG/ExperimentalUnlockRTX30",
      "placeholders": [],
      "preserve": [
        "DLSS"
      ],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "tools/packaging/customer/support/NeuRotic-HubSettings.ps1",
          "line": 0,
          "kind": "typed metadata"
        }
      ],
      "translation": "Désactivé par défaut. Enregistre l'intention de compatibilité pour le prochain lancement ; fermez et redémarrez le jeu. Nécessite un moteur de rendu RTX 30 correspondant, un fournisseur qualifié et la voie DLSS Frame Generation Streamline DirectX 12 native du jeu, avec Entrée et Sortie FG définies sur Aucun et FG de remplacement désactivé. Activez FG et choisissez les ratios via le jeu existant et les contrôles en jeu. Cette préférence ne modifie pas les voies et n'active pas FG. Dynamic MFG est indisponible. Ne pas combiner avec des déverrouilleurs externes. La qualification de gameplay reste en attente ; un backend actif reste chargé jusqu'à la sortie.",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
    {
      "id": "desktop.settings.dlssg/nativemfgexperimental.03f484d593",
      "surface": "desktop",
      "section": "saved-settings",
      "control": "paragraph",
      "english": "Default off. Saves an unlock request for the next launch; close and restart the game. Requires RTX 40, DirectX 12 and a qualified provider. Use the game's native DLSS Frame Generation with FG Input and Output set to None and replacement FG disabled in the in-game menu. Enable FG in the game's settings. This preference does not change routes or prove that higher ratios are available. Use the existing in-game ratio controls. An applied unlock remains until the game exits.",
      "context": "Saved next-launch preference: DLSSG/NativeMfgExperimental",
      "placeholders": [],
      "preserve": [
        "DLSS"
      ],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "tools/packaging/customer/support/NeuRotic-HubSettings.ps1",
          "line": 0,
          "kind": "typed metadata"
        }
      ],
      "translation": "Désactivé par défaut. Enregistre une demande de déverrouillage pour le prochain lancement ; fermez et redémarrez le jeu. Nécessite RTX 40, DirectX 12 et un fournisseur qualifié. Utilisez la DLSS Frame Generation native du jeu avec Entrée et Sortie FG définies sur Aucun et FG de remplacement désactivé dans le menu en jeu. Activez FG dans les paramètres du jeu. Cette préférence ne modifie pas les voies et ne prouve pas que des ratios plus élevés sont disponibles. Utilisez les contrôles de ratio existants en jeu. Un déverrouillage appliqué reste actif jusqu'à la fermeture du jeu.",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
    {
      "id": "desktop.settings.dlssg/nativemfgexperimental/value.ca7981b46e",
      "surface": "desktop",
      "section": "saved-settings",
      "control": "label",
      "english": "Off",
      "context": "Saved next-launch preference: DLSSG/NativeMfgExperimental/value",
      "placeholders": [],
      "preserve": [],
      "line_breaks": false,
      "revision": 1,
      "sources": [
