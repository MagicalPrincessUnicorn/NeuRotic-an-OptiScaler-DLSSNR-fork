      "section": "dlssnr-menu",
      "control": "paragraph",
      "english": "A multiplier on the scan's white point, and the control you adjust between",
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "placeholders": [],
      "preserve": [],
