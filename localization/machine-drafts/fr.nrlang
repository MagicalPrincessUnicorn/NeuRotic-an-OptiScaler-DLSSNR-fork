    {
      "id": "desktop.neurotic-hubsettings.delays_hudless_capture_high_values_can_cause_a_c_1bfdd5d1",
      "surface": "desktop",
      "section": "neurotic-hubsettings",
      "control": "paragraph",
      "english": "Delays HUDless capture. High values can cause a crash; this saved preference does not establish runtime stability.",
      "context": "Current UI: tools/packaging/customer/support/NeuRotic-HubSettings.ps1",
      "placeholders": [],
      "preserve": [],
      "line_breaks": true,
      "revision": 1,
