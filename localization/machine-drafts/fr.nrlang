    {
      "id": "ingame.dlssnr-menu.proxy_is_the_picture_handed_to_the_model_if_that_9a0bd5ff",
      "surface": "in_game",
      "section": "dlssnr-menu",
      "control": "paragraph",
      "english": "Proxy is the picture handed to the model -- if that looks wrong, the white point",
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "placeholders": [],
      "preserve": [],
      "line_breaks": false,
      "revision": 1,
      "sources": [
        {
          "path": "OptiScaler/dlssnr/DlssNr_Menu.cpp",
          "line": 3099,
          "kind": "provider"
        }
      ],
      "translation": "Le proxy est l'image transmise au modèle -- si elle semble incorrecte, le point blanc",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
    {
      "id": "ingame.dlssnr-menu.proxy_is_the_picture_handed_to_the_model_if_that_d99911fa",
      "surface": "in_game",
      "section": "dlssnr-menu",
      "control": "tooltip",
      "english": "Proxy is the picture handed to the model -- if that looks wrong, the white point\nis wrong and nothing downstream can be judged.\n\nDifference shows what the model actually changed, amplified twenty times and\ncentred on grey. A flat grey frame there means it is doing nothing.",
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "placeholders": [],
      "preserve": [],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "OptiScaler/dlssnr/DlssNr_Menu.cpp",
          "line": 2893,
          "kind": "presentation-binding"
        }
      ],
      "translation": "Le proxy est l'image transmise au modèle -- si elle semble incorrecte, le point blanc\nest incorrect et rien en aval ne peut être jugé.\n\nLa différence montre ce que le modèle a réellement changé, amplifié vingt fois et\ncentré sur le gris. Une image grise uniforme à cet endroit signifie qu'il ne fait rien.",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
    {
      "id": "ingame.dlssnr-menu.proxy_what_the_model_sees_c4cf3eb8",
      "surface": "in_game",
      "section": "dlssnr-menu",
      "control": "label",
      "english": "Proxy (what the model sees)",
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "placeholders": [],
      "preserve": [],
      "line_breaks": false,
      "revision": 1,
      "sources": [
        {
          "path": "OptiScaler/dlssnr/DlssNr_Menu.cpp",
          "line": 2887,
          "kind": "presentation-binding"
        }
      ],
      "translation": "Proxy (ce que voit le modèle)",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
    {
      "id": "ingame.dlssnr-menu.purely_a_readout_it_changes_nothing_1dd3196c",
      "surface": "in_game",
