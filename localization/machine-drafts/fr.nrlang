    {
      "id": "ingame.menu-common.ignores_small_depth_differences_before_edge_dete_07c7366b",
      "surface": "in_game",
      "section": "menu-common",
      "control": "paragraph",
      "english": "Ignores small depth differences before edge detection.\n\nHigher values reduce flickering and noise from minor depth changes, but may soften real geometry edges.\nLower values preserve fine detail but can cause unstable or noisy edge detection.",
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "placeholders": [],
      "preserve": [],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "OptiScaler/menu/menu_common.cpp",
          "line": 5518,
          "kind": "presentation-binding"
        },
        {
          "path": "OptiScaler/menu/menu_common.cpp",
          "line": 5546,
          "kind": "presentation-binding"
        }
      ],
      "translation": "Ignore les petites différences de profondeur avant la détection des contours.\n\nDes valeurs plus élevées réduisent le scintillement et le bruit dus à des changements de profondeur mineurs, mais peuvent adoucir les vrais contours de la géométrie.\nDes valeurs plus faibles préservent les détails fins, mais peuvent entraîner une détection des contours instable ou bruyante.",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
