    {
      "id": "ingame.menu-common.corresponds_to_amount_of_accumulation_added_per__48f6baf5",
      "surface": "in_game",
      "section": "menu-common",
      "control": "label",
      "english": "Corresponds to amount of accumulation added per frame",
      "context": "Current UI: OptiScaler/menu/menu_common.cpp",
      "placeholders": [],
      "preserve": [],
