    },
    {
      "id": "ingame.dlssnr-menu.puts_the_edited_frame_on_the_other_side_6301db7f",
      "surface": "in_game",
      "section": "dlssnr-menu",
      "control": "label",
      "english": "Puts the edited frame on the other side.",
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "placeholders": [],
      "preserve": [],
      "line_breaks": false,
      "revision": 1,
      "sources": [
        {
          "path": "OptiScaler/dlssnr/DlssNr_Menu.cpp",
          "line": 3057,
          "kind": "provider"
        }
      ],
      "translation": "Place l'image éditée de l'autre côté.",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
    {
      "id": "ingame.dlssnr-menu.puts_the_edited_frame_on_the_other_side_worth_do_14f1fea8",
      "surface": "in_game",
      "section": "dlssnr-menu",
      "control": "tooltip",
      "english": "Puts the edited frame on the other side.\n\nWorth doing once you have decided which you prefer: the eye is not\neven-handed about left and right, and a difference can read as an\nimprovement purely from where it sits. If the same side still wins after\nswapping, it is the pass you are seeing and not the placement.",
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
      "placeholders": [],
      "preserve": [],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "OptiScaler/dlssnr/DlssNr_Menu.cpp",
          "line": 2851,
          "kind": "presentation-binding"
        }
      ],
      "translation": "Place l'image éditée de l'autre côté.\n\nÀ faire une fois que vous avez décidé ce que vous préférez : l'œil n'est pas\nimpartial entre la gauche et la droite, et une différence peut être perçue comme une\namélioration purement par sa position. Si le même côté l'emporte toujours après\nl'échange, c'est la passe que vous voyez et non l'emplacement.",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
    {
      "id": "ingame.dlssnr-menu.quality_active_post_sr_after_native_dlss_upscale_08cd00d8",
      "surface": "in_game",
      "section": "dlssnr-menu",
      "control": "status",
      "english": "Quality active: Post-SR after native DLSS upscale.",
      "context": "Current UI: OptiScaler/dlssnr/DlssNr_Menu.cpp",
