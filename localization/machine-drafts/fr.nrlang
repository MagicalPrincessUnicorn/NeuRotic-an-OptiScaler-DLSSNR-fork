    {
      "id": "desktop.anythingview.incoming_counts_windows_capture_events_output_co_4f586cc6",
      "surface": "desktop",
      "section": "anythingview",
      "control": "paragraph",
      "english": "Incoming counts Windows capture events; Output counts accepted presentations. Neither is unique source pictures or display scanout FPS. A warning appears when output stays below 90%% of incoming (at least 5/s) for 5 seconds.",
      "context": "Current UI: apps/NeuRoticHub/anything/AnythingView.cpp",
      "placeholders": [],
      "preserve": [],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "apps/NeuRoticHub/anything/AnythingView.cpp",
          "line": 515,
          "kind": "presentation-binding"
        }
      ],
      "translation": "L'entrée compte les événements de capture Windows ; la sortie compte les présentations acceptées. Aucun des deux ne représente des images source uniques ou les IPS de balayage d'affichage. Un avertissement apparaît lorsque la sortie reste inférieure à 90%% de l'entrée (au moins 5/s) pendant 5 secondes.",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
