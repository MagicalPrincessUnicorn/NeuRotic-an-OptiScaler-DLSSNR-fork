    {
      "id": "desktop.hubshell.clears_saved_game_inspection_and_profile_data_th_b9afdcd0",
      "surface": "desktop",
      "section": "hubshell",
      "control": "paragraph",
      "english": "Clears saved game inspection and profile data. The library, hidden games and settings inside each game's folder stay unchanged. Fresh details will be read the next time you select a game. No restart is needed.",
      "context": "Current UI: apps/NeuRoticHub/ui/HubShell.cpp",
      "placeholders": [],
      "preserve": [],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "apps/NeuRoticHub/ui/HubShell.cpp",
          "line": 320,
          "kind": "presentation-binding"
        }
      ],
      "translation": "Efface les données d'inspection du jeu et de profil enregistrées. La bibliothèque, les jeux masqués et les paramètres dans le dossier de chaque jeu restent inchangés. De nouveaux détails seront lus la prochaine fois que vous sélectionnerez un jeu. Aucun redémarrage n'est nécessaire.",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
    {
      "id": "desktop.hubshell.clears_the_local_library_including_hidden_games__516f3998",
      "surface": "desktop",
      "section": "hubshell",
      "control": "paragraph",
      "english": "Clears the local library (including hidden games), preferences, game profiles, artwork, operation receipts and imported Runtime files such as NR models and Streamline. NeuRotic will restart. Installed game files are untouched.",
      "context": "Current UI: apps/NeuRoticHub/ui/HubShell.cpp",
      "placeholders": [],
      "preserve": [
        "NeuRotic"
      ],
      "line_breaks": true,
      "revision": 1,
      "sources": [
        {
          "path": "apps/NeuRoticHub/ui/HubShell.cpp",
          "line": 319,
          "kind": "presentation-binding"
        }
      ],
      "translation": "Efface la bibliothèque locale (y compris les jeux masqués), les préférences, les profils de jeu, les illustrations, les reçus d'opération et les fichiers Runtime importés tels que les modèles NR et Streamline. NeuRotic va redémarrer. Les fichiers des jeux installés sont intacts.",
      "note": "Machine draft; semantic and native-speaker review pending."
    },
