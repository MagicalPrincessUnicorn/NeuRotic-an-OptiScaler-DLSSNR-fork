<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
 <PropertyGroup>
  <NeuRoticRepoRoot Condition="'$(NeuRoticRepoRoot)'==''">$(MSBuildThisFileDirectory)..\..</NeuRoticRepoRoot>
  <NeuRoticGeneratedRoot Condition="'$(NeuRoticGeneratedRoot)'==''">$(NeuRoticRepoRoot)\builds\source\core\generated</NeuRoticGeneratedRoot>
  <NeuRoticSharedExternalRoot Condition="'$(NeuRoticSharedExternalRoot)'==''">$(NeuRoticRepoRoot)\external</NeuRoticSharedExternalRoot>
  <IncludePath>$(NeuRoticGeneratedRoot);$(NeuRoticRepoRoot)\OptiScaler;$(NeuRoticRepoRoot)\OptiScaler\include;$(NeuRoticSharedExternalRoot)\vulkan\include;$(NeuRoticRepoRoot)\external\nvngx_dlss_sdk;$(NeuRoticSharedExternalRoot)\xess\inc\xess;$(NeuRoticSharedExternalRoot)\xess\inc\xell;$(NeuRoticSharedExternalRoot)\xess\inc\xess_fg;$(NeuRoticSharedExternalRoot)\FidelityFX-SDK\ffx-api\include\ffx_api;$(NeuRoticSharedExternalRoot)\simpleini;$(NeuRoticSharedExternalRoot)\unordered_dense\include;$(NeuRoticSharedExternalRoot)\spdlog\include;$(NeuRoticRepoRoot)\external\freetype;$(NeuRoticRepoRoot)\external\streamline;$(NeuRoticRepoRoot)\external\streamline1;$(NeuRoticSharedExternalRoot)\nvapi;$(NeuRoticRepoRoot)\external\nlohmann;$(NeuRoticRepoRoot)\external\fakenvapi;$(NeuRoticSharedExternalRoot)\magic_enum\include\magic_enum;$(NeuRoticRepoRoot)\external\AntiLag2-SDK;$(NeuRoticRepoRoot)\external\latencyflex;$(IncludePath)</IncludePath>
  <LibraryPath>$(NeuRoticRepoRoot)\OptiScaler\library\fsr2;$(NeuRoticRepoRoot)\OptiScaler\library\fsr2_212;$(NeuRoticRepoRoot)\OptiScaler\library\fsr31;$(NeuRoticRepoRoot)\OptiScaler\library\vulkan;$(NeuRoticRepoRoot)\OptiScaler\library\d3dx;$(NeuRoticRepoRoot)\OptiScaler\library\detours;$(NeuRoticSharedExternalRoot)\xess\lib;$(NeuRoticRepoRoot)\external\freetype;$(LibraryPath)</LibraryPath>
 </PropertyGroup>
 <ItemDefinitionGroup>
  <ClCompile><AdditionalOptions>/MP2 /showIncludes %(AdditionalOptions)</AdditionalOptions></ClCompile>
  <ResourceCompile><AdditionalIncludeDirectories>$(NeuRoticGeneratedRoot);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories></ResourceCompile>
  <Link><AdditionalOptions>/PDBALTPATH:$(TargetName).pdb %(AdditionalOptions)</AdditionalOptions></Link>
 </ItemDefinitionGroup>
</Project>
