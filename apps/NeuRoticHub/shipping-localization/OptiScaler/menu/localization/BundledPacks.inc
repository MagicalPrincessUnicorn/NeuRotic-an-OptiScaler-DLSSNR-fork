R"NR_BUNDLE(u0430\u0442\u044c. \u0418\u0434\u0435\u043d\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u044c \u0432\n\u043f\u043e\u043b\u0443\u0442\u043e\u043d\u0430\u0445 \u2014 \u0442\u0430\u043a \u0436\u0435 \u0445\u043e\u0440\u043e\u0448\u043e, \u043a\u0430\u043a \u0438 Off \u2014 \u0438 \u043d\u0435\u043e\u0431\u0440\u0435\u0437\u0430\u043d\u043d\u043e\u0435 \u0441\u0433\u043b\u0430\u0436\u0438\u0432\u0430\u043d\u0438\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0432\n\u044f\u0440\u043a\u0438\u0445 \u0443\u0447\u0430\u0441\u0442\u043a\u0430\u0445, \u0442\u0430\u043a \u0447\u0442\u043e \u043e\u043d \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u0434\u0435\u0442\u0430\u043b\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0440\u0430\u0437\u0440\u0443\u0448\u0430\u0435\u0442 Off, \u043d\u0435 \u043e\u0442\u043a\u0430\u0437\u044b\u0432\u0430\u044f\u0441\u044c \u043e\u0442\n\u043f\u043e\u043b\u0443\u0442\u043e\u043d\u043e\u0432, \u043a\u0430\u043a \u044d\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 Neutwo. \u042d\u0442\u043e \u043f\u043e\u0447\u0442\u0438 \u043d\u0435 \u0441\u0434\u0432\u0438\u0433\u0430\u0435\u0442 paper white.\n\nReplace: \u0447\u0438\u0441\u0442\u0430\u044f \u043c\u043e\u0434\u0435\u043b\u044c, \u043f\u0440\u043e\u043f\u0443\u0449\u0435\u043d\u043d\u0430\u044f \u043e\u0431\u0440\u0430\u0442\u043d\u043e \u0447\u0435\u0440\u0435\u0437 \u0442\u043e\u0447\u043d\u0443\u044e \u0438\u043d\u0432\u0435\u0440\u0441\u0438\u044e, \u043d\u0438\u043a\u0430\u043a\u043e\u0439\n\u043a\u043e\u043c\u043f\u043e\u0437\u0438\u0446\u0438\u0438 \u2014 \u043d\u0438 \u0437\u0430\u0449\u0438\u0442\u044b, \u043d\u0438 \u043f\u0430\u043b\u0438\u0442\u0440\u044b, \u043d\u0438 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a \u0441\u0438\u043b\u044b. \u0412\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u0432\u0435\u043b\u0438\u043a\u043e\u043b\u0435\u043f\u043d\u043e \u0442\u0430\u043c, \u0433\u0434\u0435 \u043d\u0435\u0442\n\u044f\