3d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f\n\u0431\u0435\u043b\u044b\u0439 \u2014 \u0438 \u0442\u0430\u043c, \u0433\u0434\u0435 \u0431\u0443\u0444\u0435\u0440 DLSS \u0438\u0433\u0440\u044b \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0441\u043e\u0431\u043e\u0439 \u043b\u0438\u043d\u0435\u0439\u043d\u044b\u0439 HDR, \u044d\u0442\u043e \u0447\u0438\u0441\u043b\u043e\n\u0440\u0435\u0434\u043a\u043e \u0431\u044b\u0432\u0430\u0435\u0442 \u0431\u043b\u0438\u0437\u043a\u043e \u043a 1. \u041f\u0440\u0438 \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u044f\u0445 \u0432 Monster Hunter Wilds \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f 16 \u0438\u043b\u0438 \u0431\u043e\u043b\u0435\u0435,\n\u043f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u0434\u0435\u0442\u0430\u043b\u0438 \u043c\u043e\u0434\u0435\u043b\u0438 \u0432\u043e\u043e\u0431\u0449\u0435 \u0434\u043e\u0441\u0442\u0438\u0433\u043d\u0443\u0442 \u043a\u0430\u0434\u0440\u0430, \u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043f\u043e\u0434\u0445\u043e\u0434\u0438\u0442\n\u0434\u043b\u044f \u0437\u0430\u0442\u0435\u043d\u0435\u043d\u043d\u043e\u0433\u043e \u043b\u0430\u0433\u0435\u0440\u044f, \u0432\u0441\u0435 \u0435\u0449\u0435 \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u043c\u0430\u043b\u043e \u0434\u043b\u044f \u0442\u043e\u0439 \u0436\u0435 \u0438\u0433\u0440\u044b \u043f\u0440\u0438 \u0434\u043d\u0435\u0432\u043d\u043e\u043c \u0441\u0432\u0435\u0442\u0435.\n\n\u0421\u043b\u0438\u0448\u043a\u043e\u043c \u043d\u0438\u0437\u043a\u043e\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435, \u0438 \u043f\u043e\u0447\u0442\u0438 \u043a\u0430\u0436\u0434\u044b\u0439 \u043f\u0438\u043a\u0441\u0435\u043b\u044c \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442 \u043c\u044f\u0433\u043a\u043e\u0435 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0435 (soft knee): \u043c\u043e\u0434\u0435\u043b\u0438 \u0