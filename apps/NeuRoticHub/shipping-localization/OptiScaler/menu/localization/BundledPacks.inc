043c, \u0441\u043b\u0430\u0431\u043e \u0434\u043b\u044f \u044f\u0440\u043a\u0438\u0445.\n\nNeutwo composed: \u043d\u0435\u043e\u0431\u0440\u0435\u0437\u0430\u043d\u043d\u0430\u044f \u043a\u0440\u0438\u0432\u0430\u044f, \u0447\u0442\u043e\u0431\u044b \u043c\u043e\u0434\u0435\u043b\u044c \u0432\u0438\u0434\u0435\u043b\u0430 \u0434\u0435\u0442\u0430\u043b\u0438 \u0432 \u044f\u0440\u043a\u0438\u0445 \u0443\u0447\u0430\u0441\u0442\u043a\u0430\u0445, \u0437\u0430\u0442\u0435\u043c\n\u0432\u0441\u0435 \u0432\u044b\u0448\u0435\u043f\u0435\u0440\u0435\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u043e\u0435 (Detail/Colour strength, \u0437\u0430\u0449\u0438\u0442\u0430 \u044f\u0440\u043a\u0438\u0445 \u0443\u0447\u0430\u0441\u0442\u043a\u043e\u0432, \u043f\u0430\u043b\u0438\u0442\u0440\u0430). \u0412\u044b\u0438\u0433\u0440\u044b\u0432\u0430\u0435\u0442 \u0432\n\u044f\u0440\u043a\u0438\u0445 \u0441\u0446\u0435\u043d\u0430\u0445, \u043d\u043e \u043a\u0440\u0438\u0432\u0430\u044f \u0441\u0436\u0438\u043c\u0430\u0435\u0442 \u0438 \u041f\u041e\u041b\u0423\u0422\u041e\u041d\u0410, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0432 \u043a\u043e\u043d\u0442\u0435\u043d\u0442\u0435 \u0441 \u043c\u044f\u0433\u043a\u0438\u043c \u043e\u0441\u0432\u0435\u0449\u0435\u043d\u0438\u0435\u043c \u044d\u0442\u043e\n\u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u0445\u0443\u0436\u0435, \u0447\u0435\u043c Off. \u042d\u0442\u043e \u0442\u0430\u043a\u0436\u0435 \u0441\u0434\u0432\u0438\u0433\u0430\u0435\u0442 paper white \u2014 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0439\u0442\u0435 \u0437\u0430\u043d\u043e\u0432\u043e \u043f\u0440\u0438 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438.\n\nHybrid composed: \u043b\u0443\u0447\u0448\u0435\u0435 \u0438\u0437 \u043e\u0431\u043e\u0438\u0445 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432 \u0438 \u0442\u043e, \u0447\u0442\u043e \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\